@using Oqtane.Modules.Controls
@using OpenEug.TenTrees.Module.Assessment.Services
@using OpenEug.TenTrees.Module.Cohort.Services
@using OpenEug.TenTrees.Module.Grower.Services
@using OpenEug.TenTrees.Module.TreeType.Services
@using OpenEug.TenTrees.Module.Village.Services
@using OpenEug.TenTrees.Models

@namespace OpenEug.TenTrees.Module.Assessment
@inherits ModuleBase
@inject IAssessmentService AssessmentService
@inject ICohortService CohortService
@inject IGrowerService GrowerService
@inject ITreeTypeService TreeTypeService
@inject IOrchardService OrchardService
@inject IVillageService VillageService
@inject Oqtane.Services.IModuleService ModuleService
@inject Oqtane.Services.IFileService FileService
@inject NavigationManager NavigationManager
@inject IStringLocalizer<Edit> Localizer

<form @ref="form" class="@(validated ? " was-validated" : "needs-validation" )" novalidate>
    <div class="container">
        <div class="mb-2">
            <a href="@_backUrl" class="btn btn-link ps-0 text-decoration-none">
                <span class="oi oi-arrow-left me-1" aria-hidden="true"></span>@Localizer["Back"]
            </a>
        </div>
        <h3>@Localizer["FormTitle"]</h3>

        <div class="row">
            <!-- Left Column -->
            <div class="col-lg-6">
                <!-- Section 1: Grower Selection -->
                <div class="card mb-3">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">@Localizer["Section.GrowerInfo"]</h5>
                        @if (_growerId > 0 && _growerModuleId.HasValue && _growerPagePath != null)
                        {
                            var growerHref = NavigateUrl(_growerPagePath, _growerModuleId.Value, "Edit", $"id={_growerId}");
                            <a href="@growerHref" class="btn btn-sm btn-outline-secondary">
                                <span class="oi oi-person me-1" aria-hidden="true"></span>@Localizer["Action.ViewGrower"]
                            </a>
                        }
                    </div>
                    <div class="card-body">
                        @if (PageState.Action == "Add")
                        {
                            <div class="row mb-2">
                                <Label Class="col-sm-4" For="villageid" ResourceKey="Village">Village:</Label>
                                <div class="col-sm-8">
                                    <select id="villageid" class="form-select" @bind="@_selectedVillageId" @bind:after="OnVillageChanged"
                                            disabled="@IsMentorUser">
                                        <option value="">@Localizer["SelectVillage"]</option>
                                        @foreach (var v in _villages)
                                        {
                                            <option value="@v.VillageId">@v.VillageName</option>
                                        }
                                    </select>
                                </div>
                            </div>
                            <div class="row mb-2">
                                <Label Class="col-sm-4" For="cohortid" ResourceKey="Cohort">Cohort:</Label>
                                <div class="col-sm-8">
                                    <select id="cohortid" class="form-select" @bind="@_selectedCohortId" @bind:after="OnCohortChanged"
                                            disabled="@IsMentorUser">
                                        <option value="">@Localizer["SelectCohort"]</option>
                                        @foreach (var c in _cohortOptions)
                                        {
                                            <option value="@c.CohortId">@c.Name</option>
                                        }
                                    </select>
                                </div>
                            </div>
                        }
                        <div class="row mb-2">
                            <Label Class="col-sm-4" For="growerid" ResourceKey="Grower">Grower:</Label>
                            <div class="col-sm-8">
                                <select id="growerid" class="form-select" @bind="@_growerId" @bind:after="LoadTreesAsync" required disabled="@(_id > 0)">
                                    <option value="0">@Localizer["SelectGrower"]</option>
                                    @if (_growerOptions != null)
                                    {
                                        @foreach (var grower in _growerOptions)
                                        {
                                            <option value="@grower.GrowerId">@grower.GrowerName</option>
                                        }
                                    }
                                </select>
                            </div>
                        </div>
                        <div class="row mb-2">
                            <Label Class="col-sm-4" For="assessmentname" ResourceKey="Name">Assessment Name:</Label>
                            <div class="col-sm-8">
                                <input id="assessmentname" type="text" class="form-control" @bind="@_name" placeholder="e.g. GA-1" />
                            </div>
                        </div>
                        <div class="row mb-2">
                            <Label Class="col-sm-4" For="assessmentdate" ResourceKey="Date">Assessment Date:</Label>
                            <div class="col-sm-8">
                                <input id="assessmentdate" type="date" class="form-control" @bind="@_assessmentDate"
                                       @bind:after="OnAssessmentDateChanged" required />
                                @if (ShowAssessmentDateProximityWarning)
                                {
                                    <div class="alert alert-warning py-2 small mt-2 mb-0" role="status">
                                        <span class="oi oi-warning me-1" aria-hidden="true"></span>
                                        @if (_assessmentDateProximityIsDuplicate)
                                        {
                                            @string.Format(Localizer["Message.AssessmentDateDuplicateWarning"],
                                                           _assessmentDateProximityNearestDate?.ToString("yyyy-MM-dd"))
                                        }
                                        else
                                        {
                                            @string.Format(Localizer["Message.AssessmentDateProximityWarning"],
                                                           _assessmentDateProximityNearestDate?.ToString("yyyy-MM-dd"),
                                                           _assessmentDateProximityDayDiff)
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Section 2: Tree Survival -->
                <div class="card mb-3">
                    <div class="card-header">
                        <h5>@Localizer["Section.TreeSurvival"]</h5>
                    </div>
                    <div class="card-body">
                        <div class="row mb-2">
                            <Label Class="col-sm-4" For="treesplanted" ResourceKey="TreesPlanted">Trees Planted:</Label>
                            <div class="col-sm-8">
                                <input id="treesplanted" type="number" class="form-control" @bind="@_treesPlanted" required min="0" />
                            </div>
                        </div>
                        <div class="row mb-2">
                            <Label Class="col-sm-4" For="treesalive" ResourceKey="TreesAlive">Trees Still Alive:</Label>
                            <div class="col-sm-8">
                                <input id="treesalive" type="number" class="form-control" @bind="@_treesAlive" required min="0" max="@_treesPlanted" />
                            </div>
                        </div>

                        @if (_treesAlive < _treesPlanted)
                        {
                            <div class="row mb-2">
                                <Label Class="col-sm-4" For="deceasedtrees" ResourceKey="DeceasedTrees">If any died, which ones?</Label>
                                <div class="col-sm-8">
                                    <select id="deceasedtrees" class="form-select mb-2" @bind="@_deceasedTreeTypes">
                                        <option value="">@Localizer["Field.SelectTreeType"]</option>
                                        @if (_availableTreeTypes != null)
                                        {
                                            @foreach (var category in _availableTreeTypes.GroupBy(t => t.Category))
                                            {
                                                <optgroup label="@category.Key">
                                                    @foreach (var treeType in category)
                                                    {
                                                        <option value="@treeType.Name">@treeType.Name</option>
                                                    }
                                                </optgroup>
                                            }
                                        }
                                    </select>
                                    <input class="form-control" @bind="@_deceasedTreeTypesOther" placeholder="@Localizer["Field.DeceasedTreeTypesOther"]" />
                                </div>
                            </div>
                        }

                        <div class="row mb-2">
                            <div class="col-sm-4 fw-bold">@Localizer["SurvivalRate"]:</div>
                            <div class="col-sm-8">
                                <span class="badge bg-info fs-6">@SurvivalRate%</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Section 3: Problems -->
                <div class="card mb-3">
                    <div class="card-header">
                        <h5>@Localizer["Section.Problems"]</h5>
                    </div>
                    <div class="card-body">
                        @if (_trees == null || _trees.Count == 0)
                        {
                            <p class="text-muted">@Localizer["Problems.NoTrees"]</p>
                        }
                        else
                        {
                            @foreach (var tree in _trees)
                            {
                                <div class="mb-3">
                                    <div class="fw-semibold mb-1">@tree.TreeTypeName (@tree.Quantity)</div>
                                    @foreach (var problemType in AssessmentProblemTypes.All)
                                    {
                                        var treeId = tree.TreeId;
                                        var pType = problemType;
                                        var checkId = $"prob_{treeId}_{pType}";
                                        var isChecked = _problems.Any(p => p.TreeId == treeId && p.ProblemType == pType);
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" id="@checkId"
                                                   checked="@isChecked"
                                                   @onchange="@(e => ToggleProblem(treeId, pType, (bool)e.Value))" />
                                            <label class="form-check-label" for="@checkId">@Localizer[$"Problem.{pType}"]</label>
                                        </div>
                                    }
                                    @if (_problems.Any(p => p.TreeId == tree.TreeId))
                                    {
                                        var treeId = tree.TreeId;
                                        var needsHelp = _problems.Where(p => p.TreeId == treeId).Any(p => p.NeedsHelp);
                                        <div class="row mt-2 align-items-center">
                                            <div class="col-sm-8 small">@Localizer["NeedsHelp"]</div>
                                            <div class="col-sm-4">
                                                <div class="btn-group w-100" role="group">
                                                    <input type="radio" class="btn-check" name="needshelp_@treeId" id="nh_yes_@treeId" autocomplete="off"
                                                           checked="@needsHelp"
                                                           @onchange="@(() => SetNeedsHelp(treeId, true))" />
                                                    <label class="btn btn-sm btn-outline-danger" for="nh_yes_@treeId">@Localizer["Yes"]</label>
                                                    <input type="radio" class="btn-check" name="needshelp_@treeId" id="nh_no_@treeId" autocomplete="off"
                                                           checked="@(!needsHelp)"
                                                           @onchange="@(() => SetNeedsHelp(treeId, false))" />
                                                    <label class="btn btn-sm btn-outline-success" for="nh_no_@treeId">@Localizer["No"]</label>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                                <hr />
                            }
                        }

                        <div class="mt-3 pt-3 border-top">
                            <h6 class="mb-1">
                                <span class="oi oi-camera-slr me-1" aria-hidden="true"></span>@Localizer["Photo.Heading"]
                            </h6>
                            <p class="text-muted small mb-2">
                                @string.Format(Localizer["Photo.Help"], AssessmentPhotoRules.MaxPhotosPerAssessment, AssessmentPhotoRules.MaxPhotoMegabytes)
                            </p>
                            @if (_id > 0 && _photoFolderId > 0)
                            {
                                <FileManager Id="assessmentProblemPhotos"
                                             FolderId="@_photoFolderId"
                                             Filter="jpg,jpeg,png,webp"
                                             ShowFolders="false"
                                             ShowFiles="false"
                                             ShowImage="false"
                                             UploadMultiple="false"
                                             MaxUploadFileSize="@AssessmentPhotoRules.MaxPhotoMegabytes"
                                             ShowProgress="true"
                                             ShowSuccess="true"
                                             OnUpload="OnPhotoUploadedAsync" />
                            }
                            else if (_id == 0)
                            {
                                <div class="alert alert-info small mb-0" role="status">@Localizer["Photo.SaveFirst"]</div>
                            }

                            <div class="d-flex justify-content-between align-items-center mt-2 small" role="status" aria-live="polite">
                                <span>@string.Format(Localizer["Photo.Count"], _existingPhotos.Count, AssessmentPhotoRules.MaxPhotosPerAssessment)</span>
                                @if (_isPhotoBusy)
                                {
                                    <span><span class="spinner-border spinner-border-sm me-1" aria-hidden="true"></span>@Localizer["Photo.Processing"]</span>
                                }
                            </div>

                            @if (_existingPhotos.Count > 0)
                            {
                                <div class="row g-2 mt-1">
                                    @foreach (var photo in _existingPhotos)
                                    {
                                        <div class="col-6 col-sm-4">
                                            <div class="card h-100">
                                                <img src="@photo.Url"
                                                     class="card-img-top"
                                                     style="height: 140px; object-fit: cover;"
                                                     alt="@Localizer["Photo.ExistingAlt"]" />
                                                <div class="card-body p-2">
                                                    <div class="small text-muted text-truncate" title="@photo.FileName">@photo.FileName</div>
                                                    <button type="button"
                                                            class="btn btn-outline-danger w-100 mt-1"
                                                            @onclick="@(() => DeleteExistingPhotoAsync(photo))"
                                                            disabled="@_isPhotoBusy">
                                                        <span class="oi oi-trash me-1" aria-hidden="true"></span>@Localizer["Photo.Remove"]
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right Column -->
            <div class="col-lg-6">
                <!-- Section 4: Permaculture Practices -->
                <div class="card mb-3">
                    <div class="card-header">
                        <h5>@Localizer["Section.Permaculture"]</h5>
                    </div>
                    <div class="card-body">
                        <div class="row mb-2 align-items-center">
                            <Label Class="col-sm-8 mb-0" For="prac_healthy" ResourceKey="Practice.Healthy">Do the trees look healthy?</Label>
                            <div class="col-sm-4">
                                <div class="btn-group w-100" role="group">
                                    <input type="radio" class="btn-check" name="prac_healthy" id="prac_healthy_yes" autocomplete="off" checked="@(_treesLookHealthy == true)" @onchange="@(() => _treesLookHealthy = true)">
                                    <label class="btn btn-outline-success" for="prac_healthy_yes">@Localizer["Yes"]</label>
                                    <input type="radio" class="btn-check" name="prac_healthy" id="prac_healthy_no" autocomplete="off" checked="@(_treesLookHealthy == false)" @onchange="@(() => _treesLookHealthy = false)">
                                    <label class="btn btn-outline-danger" for="prac_healthy_no">@Localizer["No"]</label>
                                </div>
                            </div>
                        </div>
                        <div class="row mb-2 align-items-center">
                            <Label Class="col-sm-8 mb-0" For="prac_chem" ResourceKey="Practice.Chemicals">Any chemical fertilizers?</Label>
                            <div class="col-sm-4">
                                <div class="btn-group w-100" role="group">
                                    <input type="radio" class="btn-check" name="prac_chem" id="prac_chem_yes" autocomplete="off" checked="@(_hasChemicalFertilizers == true)" @onchange="@(() => _hasChemicalFertilizers = true)">
                                    <label class="btn btn-outline-danger" for="prac_chem_yes">@Localizer["Yes"]</label>
                                    <input type="radio" class="btn-check" name="prac_chem" id="prac_chem_no" autocomplete="off" checked="@(_hasChemicalFertilizers == false)" @onchange="@(() => _hasChemicalFertilizers = false)">
                                    <label class="btn btn-outline-success" for="prac_chem_no">@Localizer["No"]</label>
                                </div>
                            </div>
                        </div>
                        <div class="row mb-2 align-items-center">
                            <Label Class="col-sm-8 mb-0" For="prac_pest" ResourceKey="Practice.Pesticides">Any pesticides used?</Label>
                            <div class="col-sm-4">
                                <div class="btn-group w-100" role="group">
                                    <input type="radio" class="btn-check" name="prac_pest" id="prac_pest_yes" autocomplete="off" checked="@(_hasPesticides == true)" @onchange="@(() => _hasPesticides = true)">
                                    <label class="btn btn-outline-danger" for="prac_pest_yes">@Localizer["Yes"]</label>
                                    <input type="radio" class="btn-check" name="prac_pest" id="prac_pest_no" autocomplete="off" checked="@(_hasPesticides == false)" @onchange="@(() => _hasPesticides = false)">
                                    <label class="btn btn-outline-success" for="prac_pest_no">@Localizer["No"]</label>
                                </div>
                            </div>
                        </div>
                        <div class="row mb-2 align-items-center">
                            <Label Class="col-sm-8 mb-0" For="prac_mulch" ResourceKey="Practice.Mulched">Are the trees mulched?</Label>
                            <div class="col-sm-4">
                                <div class="btn-group w-100" role="group">
                                    <input type="radio" class="btn-check" name="prac_mulch" id="prac_mulch_yes" autocomplete="off" checked="@(_isMulched == true)" @onchange="@(() => _isMulched = true)">
                                    <label class="btn btn-outline-success" for="prac_mulch_yes">@Localizer["Yes"]</label>
                                    <input type="radio" class="btn-check" name="prac_mulch" id="prac_mulch_no" autocomplete="off" checked="@(_isMulched == false)" @onchange="@(() => _isMulched = false)">
                                    <label class="btn btn-outline-danger" for="prac_mulch_no">@Localizer["No"]</label>
                                </div>
                            </div>
                        </div>
                        <div class="row mb-2 align-items-center">
                            <Label Class="col-sm-8 mb-0" For="prac_compost" ResourceKey="Practice.Compost">Are they making compost?</Label>
                            <div class="col-sm-4">
                                <div class="btn-group w-100" role="group">
                                    <input type="radio" class="btn-check" name="prac_compost" id="prac_compost_yes" autocomplete="off" checked="@(_isMakingCompost == true)" @onchange="@(() => _isMakingCompost = true)">
                                    <label class="btn btn-outline-success" for="prac_compost_yes">@Localizer["Yes"]</label>
                                    <input type="radio" class="btn-check" name="prac_compost" id="prac_compost_no" autocomplete="off" checked="@(_isMakingCompost == false)" @onchange="@(() => _isMakingCompost = false)">
                                    <label class="btn btn-outline-danger" for="prac_compost_no">@Localizer["No"]</label>
                                </div>
                            </div>
                        </div>
                        <div class="row mb-2 align-items-center">
                            <Label Class="col-sm-8 mb-0" For="prac_water" ResourceKey="Practice.CollectingWater">Are they collecting water?</Label>
                            <div class="col-sm-4">
                                <div class="btn-group w-100" role="group">
                                    <input type="radio" class="btn-check" name="prac_water" id="prac_water_yes" autocomplete="off" checked="@(_isCollectingWater == true)" @onchange="@(() => _isCollectingWater = true)">
                                    <label class="btn btn-outline-success" for="prac_water_yes">@Localizer["Yes"]</label>
                                    <input type="radio" class="btn-check" name="prac_water" id="prac_water_no" autocomplete="off" checked="@(_isCollectingWater == false)" @onchange="@(() => _isCollectingWater = false)">
                                    <label class="btn btn-outline-danger" for="prac_water_no">@Localizer["No"]</label>
                                </div>
                            </div>
                        </div>
                        <div class="row mb-2 align-items-center">
                            <Label Class="col-sm-8 mb-0" For="prac_leaks" ResourceKey="Practice.LeakyTaps">Any leaky taps visible?</Label>
                            <div class="col-sm-4">
                                <div class="btn-group w-100" role="group">
                                    <input type="radio" class="btn-check" name="prac_leaks" id="prac_leaks_yes" autocomplete="off" checked="@(_hasLeakyTaps == true)" @onchange="@(() => _hasLeakyTaps = true)">
                                    <label class="btn btn-outline-danger" for="prac_leaks_yes">@Localizer["Yes"]</label>
                                    <input type="radio" class="btn-check" name="prac_leaks" id="prac_leaks_no" autocomplete="off" checked="@(_hasLeakyTaps == false)" @onchange="@(() => _hasLeakyTaps = false)">
                                    <label class="btn btn-outline-success" for="prac_leaks_no">@Localizer["No"]</label>
                                </div>
                            </div>
                        </div>
                        <div class="row mb-2 align-items-center">
                            <Label Class="col-sm-8 mb-0" For="prac_design" ResourceKey="Practice.GardenDesign">Is the garden designed to capture water?</Label>
                            <div class="col-sm-4">
                                <div class="btn-group w-100" role="group">
                                    <input type="radio" class="btn-check" name="prac_design" id="prac_design_yes" autocomplete="off" checked="@(_isGardenDesignedToCaptureWater == true)" @onchange="@(() => _isGardenDesignedToCaptureWater = true)">
                                    <label class="btn btn-outline-success" for="prac_design_yes">@Localizer["Yes"]</label>
                                    <input type="radio" class="btn-check" name="prac_design" id="prac_design_no" autocomplete="off" checked="@(_isGardenDesignedToCaptureWater == false)" @onchange="@(() => _isGardenDesignedToCaptureWater = false)">
                                    <label class="btn btn-outline-danger" for="prac_design_no">@Localizer["No"]</label>
                                </div>
                            </div>
                        </div>
                        <div class="row mb-2 align-items-center">
                            <Label Class="col-sm-8 mb-0" For="prac_grey" ResourceKey="Practice.Greywater">Are they using greywater?</Label>
                            <div class="col-sm-4">
                                <div class="btn-group w-100" role="group">
                                    <input type="radio" class="btn-check" name="prac_grey" id="prac_grey_yes" autocomplete="off" checked="@(_isUsingGreywater == true)" @onchange="@(() => _isUsingGreywater = true)">
                                    <label class="btn btn-outline-success" for="prac_grey_yes">@Localizer["Yes"]</label>
                                    <input type="radio" class="btn-check" name="prac_grey" id="prac_grey_no" autocomplete="off" checked="@(_isUsingGreywater == false)" @onchange="@(() => _isUsingGreywater = false)">
                                    <label class="btn btn-outline-danger" for="prac_grey_no">@Localizer["No"]</label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Section 5: Notes Log -->
                <div class="card mb-3">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">@Localizer["Section.Notes"]</h5>
                        @if (_existingNotes.Count + _pendingNotes.Count > 0)
                        {
                            <span class="badge bg-secondary">@(_existingNotes.Count + _pendingNotes.Count)</span>
                        }
                    </div>
                    <div class="card-body">
                        @if (_existingNotes.Count == 0 && _pendingNotes.Count == 0)
                        {
                            <p class="text-muted small mb-3">@Localizer["Notes.Empty"]</p>
                        }
                        else
                        {
                            <ul class="list-unstyled mb-3">
                                @foreach (var note in _existingNotes.OrderBy(n => n.CreatedOn))
                                {
                                    <li class="mb-2 pb-2 border-bottom">
                                        <div class="mb-1">
                                            @if (note.NoteType == AssessmentNoteTypes.HomeVisit)
                                            {
                                                <span class="badge bg-warning text-dark me-1">@Localizer["Note.TypeHomeVisit"]</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary me-1">@Localizer["Note.TypeGeneral"]</span>
                                            }
                                            <small class="text-muted">@note.CreatedOn.ToLocalTime().ToString("yyyy-MM-dd HH:mm") — @note.CreatedBy</small>
                                        </div>
                                        <div class="text-body" style="white-space: pre-wrap;">@note.Text</div>
                                    </li>
                                }
                                @for (int i = 0; i < _pendingNotes.Count; i++)
                                {
                                    var note = _pendingNotes[i];
                                    var pendingIndex = i;
                                    <li class="mb-2 pb-2 border-bottom bg-light px-2 py-2 rounded">
                                        <div class="d-flex justify-content-between align-items-start mb-1">
                                            <span>
                                                @if (note.NoteType == AssessmentNoteTypes.HomeVisit)
                                                {
                                                    <span class="badge bg-warning text-dark me-1">@Localizer["Note.TypeHomeVisit"]</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary me-1">@Localizer["Note.TypeGeneral"]</span>
                                                }
                                                <small class="text-muted">@Localizer["Note.PendingLabel"]</small>
                                            </span>
                                            <button type="button" class="btn btn-sm btn-link text-danger p-0"
                                                    @onclick="@(() => RemovePendingNote(pendingIndex))"
                                                    aria-label="@Localizer["Note.RemoveAriaLabel"]">
                                                <span class="oi oi-x" aria-hidden="true"></span>
                                            </button>
                                        </div>
                                        <div class="text-body" style="white-space: pre-wrap;">@note.Text</div>
                                    </li>
                                }
                            </ul>
                        }

                        @if (_problems.Any(p => p.NeedsHelp))
                        {
                            <div class="alert alert-warning py-2 small mb-2" role="status">
                                <span class="oi oi-warning me-1" aria-hidden="true"></span>
                                @Localizer["Note.NeedsHelpAlert"]
                            </div>
                        }

                        <div class="mb-2">
                            <label for="newNoteText" class="form-label mb-1">@Localizer["Note.AddLabel"]</label>
                            <textarea id="newNoteText" class="form-control mb-2" rows="3"
                                      placeholder="@Localizer["Note.Placeholder"]"
                                      @bind="_newNoteText"></textarea>
                            <div class="d-flex align-items-center gap-2 flex-wrap">
                                <label for="newNoteType" class="visually-hidden">@Localizer["Note.TypeLabel"]</label>
                                <select id="newNoteType" class="form-select form-select-sm w-auto" @bind="_newNoteType">
                                    <option value="@AssessmentNoteTypes.General">@Localizer["Note.TypeGeneral"]</option>
                                    <option value="@AssessmentNoteTypes.HomeVisit">@Localizer["Note.TypeHomeVisit"]</option>
                                </select>
                                <button type="button" class="btn btn-sm btn-outline-primary"
                                        @onclick="AddPendingNote">
                                    <span class="oi oi-plus me-1" aria-hidden="true"></span>@Localizer["Note.AddButton"]
                                </button>
                                <small class="text-muted ms-auto">@Localizer["Note.ImmutableHint"]</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <button type="button" class="btn btn-success" @onclick="Save">@Localizer["Save"]</button>
    <button type="button" class="btn btn-outline-secondary" @onclick="SaveDraft">@Localizer["SaveDraft"]</button>
    @if (_hasDraft)
    {
        <button type="button" class="btn btn-outline-info" @onclick="LoadDraft">@Localizer["LoadDraft"]</button>
    }
    <NavLink class="btn btn-secondary" href="@_backUrl">@Localizer["Cancel"]</NavLink>
    @if (PageState.Action == "Edit")
    {
        <ActionDialog Header="@Localizer["Dialog.Delete.Header"]"
                      Message="@Localizer["Dialog.Delete.Message"]"
                      Action="Delete"
                      Security="SecurityAccessLevel.Edit"
                      Class="btn btn-danger ms-2"
                      OnClick="@(async () => await Delete())"
                      ResourceKey="Delete" />
    }
    <br /><br />
    @if (PageState.Action == "Edit")
    {
        <AuditInfo CreatedBy="@_createdby" CreatedOn="@_createdon" ModifiedBy="@_modifiedby" ModifiedOn="@_modifiedon"></AuditInfo>
    }
</form>

@code {
    public override string Actions => "Add,Edit";
    public override string Title => "Manage Assessment";
    public override bool UseAdminContainer => false;

    private bool IsMentorUser => UserSecurity.IsAuthorized(PageState.User, AppRoleNames.Mentor);

    private ElementReference form;
    private bool validated = false;

    private int _id;
    private List<Models.Grower> _growers;
    private List<Models.Grower> _growerOptions = new();
    private List<Models.Village> _villages = new();
    private List<Models.Cohort> _cohortOptions = new();
    private HashSet<int> _cohortGrowerIds;
    private string _selectedVillageId = "";
    private string _selectedCohortId = "";
    private List<Models.TreeType> _availableTreeTypes;
    private List<TreeDetailDto> _trees = new();
    private List<Models.AssessmentProblem> _problems = new();
    private int? _growerModuleId;
    private string? _growerPagePath;

    // Basic Info
    private int _growerId;
    private string _name;
    private DateTime _assessmentDate = DateTime.Today;

    // Assessment Date proximity warning (non-blocking; see Issue #180)
    private List<Models.Assessment> _growerAssessmentHistory = new();
    private int _assessmentFrequencyDays = 30; // resolved from grower's most-recently-activated cohort
    private int? _assessmentDateProximityDayDiff;
    private DateTime? _assessmentDateProximityNearestDate;
    private bool _assessmentDateProximityIsDuplicate;

    private bool ShowAssessmentDateProximityWarning =>
        _assessmentDateProximityDayDiff.HasValue &&
        _assessmentDateProximityDayDiff.Value <= _assessmentFrequencyDays;

    // Tree Survival
    private int _treesPlanted;
    private int _treesAlive;
    private string _deceasedTreeTypes;
    private string _deceasedTreeTypesOther;

    // Problems
    private bool _hasBrokenBranches;
    private bool _hasYellowLeaves;
    private bool _hasLosingLeaves;
    private bool _hasLookDry;
    private bool _hasPests;
    private bool _needsHelp;

    // Problem photos
    private List<AssessmentPhotoDto> _existingPhotos = new();
    private int _photoFolderId;
    private bool _isPhotoBusy;

    // Permaculture Practices
    private bool _treesLookHealthy;
    private bool _hasChemicalFertilizers;
    private bool _hasPesticides;
    private bool _isMulched;
    private bool _isMakingCompost;
    private bool _isCollectingWater;
    private bool _hasLeakyTaps;
    private bool _isGardenDesignedToCaptureWater;
    private bool _isUsingGreywater;

    // Notes log
    private List<Models.AssessmentNote> _existingNotes = new();
    private List<Models.AssessmentNote> _pendingNotes = new();
    private string _newNoteText = string.Empty;
    private string _newNoteType = AssessmentNoteTypes.General;

    // Audit fields
    private string _createdby;
    private DateTime _createdon;
    private string _modifiedby;
    private DateTime _modifiedon;

    private bool _loaded = false;
    private string _backUrl => PageState.QueryString.ContainsKey("returnurl")
        ? Uri.UnescapeDataString(PageState.QueryString["returnurl"])
        : NavigateUrl();
    private bool _hasDraft = false;
    private const string DraftKey = "TenTrees_Assessment_Draft_V2";

    private class AssessmentDraft
    {
        public Models.Assessment Assessment { get; set; }
        public List<Models.AssessmentNote> PendingNotes { get; set; } = new();
    }

    private int SurvivalRate => _treesPlanted > 0 ? (_treesAlive * 100 / _treesPlanted) : 0;

    protected override async Task OnParametersSetAsync()
    {
        if (_loaded) return;
        _loaded = true;

        try
        {
            await LoadGrowerModuleAsync();
            var allGrowers = await GrowerService.GetActiveGrowersAsync();
            _availableTreeTypes = await TreeTypeService.GetActiveTreeTypesAsync();

            _growers = allGrowers;
            _growerOptions = _growers;

            if (PageState.Action == "Add")
            {
                if (IsMentorUser)
                {
                    await LoadMentorActiveCohortAsync();
                }
                else
                {
                    _villages = await VillageService.GetActiveVillagesAsync() ?? new();

                    if (PageState.QueryString.ContainsKey("villageId") &&
                        int.TryParse(PageState.QueryString["villageId"], out var preVillageId) && preVillageId > 0 &&
                        _villages.Any(v => v.VillageId == preVillageId))
                    {
                        _selectedVillageId = preVillageId.ToString();
                    }

                    await LoadCohortOptionsAsync();

                    if (PageState.QueryString.ContainsKey("cohortId") &&
                        int.TryParse(PageState.QueryString["cohortId"], out var preCohortId) && preCohortId > 0 &&
                        _cohortOptions.Any(c => c.CohortId == preCohortId))
                    {
                        _selectedCohortId = preCohortId.ToString();
                        await LoadCohortMembersAsync();
                    }
                }

                RebuildGrowerOptions();

                if (PageState.QueryString.ContainsKey("growerId") &&
                    int.TryParse(PageState.QueryString["growerId"], out var preGrowerId) && preGrowerId > 0 &&
                    _growerOptions.Any(g => g.GrowerId == preGrowerId))
                {
                    _growerId = preGrowerId;
                    await LoadTreesAsync();
                }
            }

            if (PageState.Action == "Edit")
            {
                if (PageState.QueryString.ContainsKey("id"))
                {
                    _id = Int32.Parse(PageState.QueryString["id"]);
                    Models.Assessment assessment = await AssessmentService.GetAssessmentAsync(_id);
                    if (assessment != null)
                    {
                        _growerId = assessment.GrowerId;
                        _name = assessment.Name;
                        _assessmentDate = assessment.AssessmentDate;

                        _treesPlanted = assessment.TreesPlanted;
                        _treesAlive = assessment.TreesAlive;

                        if (!string.IsNullOrEmpty(assessment.DeceasedTreeTypes))
                        {
                            if (_availableTreeTypes?.Any(t => t.Name == assessment.DeceasedTreeTypes) == true)
                            {
                                _deceasedTreeTypes = assessment.DeceasedTreeTypes;
                            }
                            else
                            {
                                _deceasedTreeTypesOther = assessment.DeceasedTreeTypes;
                            }
                        }

                        _hasBrokenBranches = assessment.HasBrokenBranches;
                        _hasYellowLeaves = assessment.HasYellowLeaves;
                        _hasLosingLeaves = assessment.HasLosingLeaves;
                        _hasLookDry = assessment.HasLookDry;
                        _hasPests = assessment.HasPests;
                        _needsHelp = assessment.NeedsHelp;

                        _treesLookHealthy = assessment.TreesLookHealthy;
                        _hasChemicalFertilizers = assessment.HasChemicalFertilizers;
                        _hasPesticides = assessment.HasPesticides;
                        _isMulched = assessment.IsMulched;
                        _isMakingCompost = assessment.IsMakingCompost;
                        _isCollectingWater = assessment.IsCollectingWater;
                        _hasLeakyTaps = assessment.HasLeakyTaps;
                        _isGardenDesignedToCaptureWater = assessment.IsGardenDesignedToCaptureWater;
                        _isUsingGreywater = assessment.IsUsingGreywater;

                        _existingNotes = await AssessmentService.GetNotesByAssessmentAsync(_id) ?? new List<Models.AssessmentNote>();
                        await LoadTreesAsync();
                        _problems = await AssessmentService.GetProblemsByAssessmentAsync(_id) ?? new List<Models.AssessmentProblem>();
                        _photoFolderId = await AssessmentService.GetPhotoFolderIdAsync(_id) ?? 0;
                        await LoadExistingPhotosAsync();

                        _createdby = assessment.CreatedBy;
                        _createdon = assessment.CreatedOn;
                        _modifiedby = assessment.ModifiedBy;
                        _modifiedon = assessment.ModifiedOn;
                    }
                }
            }
        }
        catch (Exception ex)
        {
            await logger.LogError(ex, "Error Loading Assessment {AssessmentId} {Error}", _id, ex.Message);
            AddModuleMessage(Localizer["Message.LoadError"], MessageType.Error);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var hasDraft = false;
            try
            {
                var draft = await JSRuntime.InvokeAsync<string>("localStorage.getItem", DraftKey);
                hasDraft = !string.IsNullOrEmpty(draft);
            }
            catch
            {
                // Ignore JS interop errors during prerendering
            }

            if (hasDraft)
            {
                _hasDraft = true;
                StateHasChanged();
            }
        }
    }

    private async Task SaveDraft()
    {
        try
        {
            var draft = new AssessmentDraft
            {
                Assessment = new Models.Assessment
                {
                    GrowerId = _growerId,
                    Name = _name,
                    AssessmentDate = _assessmentDate,
                    TreesPlanted = _treesPlanted,
                    TreesAlive = _treesAlive,
                    DeceasedTreeTypes = !string.IsNullOrEmpty(_deceasedTreeTypesOther) ? _deceasedTreeTypesOther : _deceasedTreeTypes,
                    TreesLookHealthy = _treesLookHealthy,
                    HasChemicalFertilizers = _hasChemicalFertilizers,
                    HasPesticides = _hasPesticides,
                    IsMulched = _isMulched,
                    IsMakingCompost = _isMakingCompost,
                    IsCollectingWater = _isCollectingWater,
                    HasLeakyTaps = _hasLeakyTaps,
                    IsGardenDesignedToCaptureWater = _isGardenDesignedToCaptureWater,
                    IsUsingGreywater = _isUsingGreywater
                },
                PendingNotes = _pendingNotes
            };
            ApplyLegacyProblemFlags(draft.Assessment);

            var json = System.Text.Json.JsonSerializer.Serialize(draft);
            await JSRuntime.InvokeVoidAsync("localStorage.setItem", DraftKey, json);
            _hasDraft = true;
            AddModuleMessage(Localizer["Message.DraftSaved"], MessageType.Success);
        }
        catch (Exception ex)
        {
            await logger.LogError(ex, "Error Saving Draft {Error}", ex.Message);
            AddModuleMessage(Localizer["Message.SaveError"], MessageType.Error);
        }
    }

    private async Task LoadDraft()
    {
        try
        {
            var json = await JSRuntime.InvokeAsync<string>("localStorage.getItem", DraftKey);
            if (!string.IsNullOrEmpty(json))
            {
                var draft = System.Text.Json.JsonSerializer.Deserialize<AssessmentDraft>(json);
                if (draft?.Assessment != null)
                {
                    var a = draft.Assessment;
                    _growerId = a.GrowerId;
                    _name = a.Name;
                    _assessmentDate = a.AssessmentDate;
                    _treesPlanted = a.TreesPlanted;
                    _treesAlive = a.TreesAlive;

                    if (!string.IsNullOrEmpty(a.DeceasedTreeTypes))
                    {
                        if (_availableTreeTypes != null && _availableTreeTypes.Any(t => t.Name == a.DeceasedTreeTypes))
                        {
                            _deceasedTreeTypes = a.DeceasedTreeTypes;
                        }
                        else
                        {
                            _deceasedTreeTypesOther = a.DeceasedTreeTypes;
                        }
                    }
                    _hasBrokenBranches = a.HasBrokenBranches;
                    _hasYellowLeaves = a.HasYellowLeaves;
                    _hasLosingLeaves = a.HasLosingLeaves;
                    _hasLookDry = a.HasLookDry;
                    _hasPests = a.HasPests;
                    _needsHelp = a.NeedsHelp;
                    _treesLookHealthy = a.TreesLookHealthy;
                    _hasChemicalFertilizers = a.HasChemicalFertilizers;
                    _hasPesticides = a.HasPesticides;
                    _isMulched = a.IsMulched;
                    _isMakingCompost = a.IsMakingCompost;
                    _isCollectingWater = a.IsCollectingWater;
                    _hasLeakyTaps = a.HasLeakyTaps;
                    _isGardenDesignedToCaptureWater = a.IsGardenDesignedToCaptureWater;
                    _isUsingGreywater = a.IsUsingGreywater;

                    _pendingNotes = draft.PendingNotes ?? new List<Models.AssessmentNote>();

                    AddModuleMessage(Localizer["Message.DraftLoaded"], MessageType.Success);
                }
            }
        }
        catch (Exception ex)
        {
            await logger.LogError(ex, "Error Loading Draft {Error}", ex.Message);
            AddModuleMessage(Localizer["Message.LoadError"], MessageType.Error);
        }
    }

    private async Task Save()
    {
        try
        {
            validated = true;
            var interop = new Oqtane.UI.Interop(JSRuntime);
            if (await interop.FormValid(form))
            {
                if (_growerId == 0)
                {
                    AddModuleMessage(Localizer["Message.SelectGrower"], MessageType.Warning);
                    return;
                }

                RecalculateAssessmentDateProximityWarning();

                if (!string.IsNullOrWhiteSpace(_newNoteText))
                {
                    AddPendingNote();
                }

                if (PageState.Action == "Add")
                {
                    // Exited/inactive-grower hard block only — frequency is a non-blocking warning now.
                    bool growerEligible = await AssessmentService.CanSubmitAssessmentAsync(_growerId);
                    if (!growerEligible)
                    {
                        AddModuleMessage(Localizer["Message.GrowerNotEligibleError"], MessageType.Warning);
                        return;
                    }

                    Models.Assessment assessment = new Models.Assessment();

                    assessment.GrowerId = _growerId;
                    assessment.Name = _name;
                    assessment.AssessmentDate = _assessmentDate;

                    assessment.TreesPlanted = _treesPlanted;
                    assessment.TreesAlive = _treesAlive;
                    assessment.DeceasedTreeTypes = !string.IsNullOrEmpty(_deceasedTreeTypesOther) ? _deceasedTreeTypesOther : _deceasedTreeTypes;
                    ApplyLegacyProblemFlags(assessment);

                    assessment.TreesLookHealthy = _treesLookHealthy;
                    assessment.HasChemicalFertilizers = _hasChemicalFertilizers;
                    assessment.HasPesticides = _hasPesticides;
                    assessment.IsMulched = _isMulched;
                    assessment.IsMakingCompost = _isMakingCompost;
                    assessment.IsCollectingWater = _isCollectingWater;
                    assessment.HasLeakyTaps = _hasLeakyTaps;
                    assessment.IsGardenDesignedToCaptureWater = _isGardenDesignedToCaptureWater;
                    assessment.IsUsingGreywater = _isUsingGreywater;

                    assessment.SubmittedBy = PageState.User.Username;
                    assessment.EnteredByAdmin = UserSecurity.IsAuthorized(PageState.User, AppRoleNames.TenTreesAdmin);

                    assessment = await AssessmentService.AddAssessmentAsync(assessment);
                    await logger.LogInformation("Assessment Added {Assessment}", assessment);
                    await AssessmentService.ReplaceProblemsAsync(assessment.AssessmentId, _problems);

                    if (await PersistPendingNotesAsync(assessment.AssessmentId))
                    {
                        await JSRuntime.InvokeVoidAsync("localStorage.removeItem", DraftKey);
                        AddModuleMessage(Localizer["Message.SaveSuccess"], MessageType.Success);
                        NavigationManager.NavigateTo(EditUrl("Edit", $"id={assessment.AssessmentId}&returnurl={Uri.EscapeDataString(_backUrl)}"));
                    }
                }
                else
                {
                    Models.Assessment assessment = await AssessmentService.GetAssessmentAsync(_id);

                    assessment.AssessmentDate = _assessmentDate;

                    assessment.Name = _name;
                    assessment.TreesPlanted = _treesPlanted;
                    assessment.TreesAlive = _treesAlive;
                    assessment.DeceasedTreeTypes = !string.IsNullOrEmpty(_deceasedTreeTypesOther) ? _deceasedTreeTypesOther : _deceasedTreeTypes;
                    ApplyLegacyProblemFlags(assessment);

                    assessment.TreesLookHealthy = _treesLookHealthy;
                    assessment.HasChemicalFertilizers = _hasChemicalFertilizers;
                    assessment.HasPesticides = _hasPesticides;
                    assessment.IsMulched = _isMulched;
                    assessment.IsMakingCompost = _isMakingCompost;
                    assessment.IsCollectingWater = _isCollectingWater;
                    assessment.HasLeakyTaps = _hasLeakyTaps;
                    assessment.IsGardenDesignedToCaptureWater = _isGardenDesignedToCaptureWater;
                    assessment.IsUsingGreywater = _isUsingGreywater;

                    await AssessmentService.UpdateAssessmentAsync(assessment);
                    await logger.LogInformation("Assessment Updated {Assessment}", assessment);
                    await AssessmentService.ReplaceProblemsAsync(assessment.AssessmentId, _problems);

                    if (await PersistPendingNotesAsync(assessment.AssessmentId))
                    {
                        await JSRuntime.InvokeVoidAsync("localStorage.removeItem", DraftKey);
                        AddModuleMessage(Localizer["Message.UpdateSuccess"], MessageType.Success);
                        NavigationManager.NavigateTo(_backUrl);
                    }
                }
            }
            else
            {
                AddModuleMessage(Localizer["Message.SaveValidation"], MessageType.Warning);
            }
        }
        catch (Exception ex)
        {
            await logger.LogError(ex, "Error Saving Assessment {Error}", ex.Message);
            AddModuleMessage(Localizer["Message.SaveError"], MessageType.Error);
        }
    }

    private async Task Delete()
    {
        try
        {
            await AssessmentService.DeleteAssessmentAsync(_id);
            await logger.LogInformation("Assessment Deleted {AssessmentId}", _id);
            NavigationManager.NavigateTo(_backUrl);
        }
        catch (Exception ex)
        {
            await logger.LogError(ex, "Error Deleting Assessment {AssessmentId} {Error}", _id, ex.Message);
            AddModuleMessage(Localizer["Message.DeleteError"], MessageType.Error);
        }
    }

    private void OnNeedsHelpChanged(bool needsHelp)
    {
        _needsHelp = needsHelp;
        if (needsHelp && string.IsNullOrWhiteSpace(_newNoteText))
        {
            // Pre-select the Home Visit note type so the composer is ready
            // for the required follow-up explaining the issue.
            _newNoteType = AssessmentNoteTypes.HomeVisit;
        }
    }

    private int? _treesLoadedForGrowerId;

    private void ResetProblemsForGrowerChange()
    {
        _problems = new();
    }

    private async Task LoadMentorActiveCohortAsync()
    {
        var cohorts = await CohortService.GetCohortsByMentorAsync(PageState.User?.Username) ?? new();
        var activeCohort = cohorts
            .Where(c => c.Status == CohortStatus.Active)
            .OrderByDescending(c => c.ActivatedOn)
            .FirstOrDefault();

        if (activeCohort == null)
        {
            return;
        }

        _cohortOptions = new List<Models.Cohort> { activeCohort };
        _selectedCohortId = activeCohort.CohortId.ToString();
        _selectedVillageId = activeCohort.VillageId.ToString();
        _villages = await VillageService.GetActiveVillagesAsync() ?? new();

        await LoadCohortMembersAsync();
    }

    private async Task LoadCohortOptionsAsync()
    {
        var villageId = ParseNullableInt(_selectedVillageId);
        _cohortOptions = villageId.HasValue
            ? await CohortService.GetCohortsByVillageAsync(villageId.Value) ?? new()
            : await CohortService.GetCohortsAsync() ?? new();

        if (!_cohortOptions.Any(c => c.CohortId.ToString() == _selectedCohortId))
        {
            _selectedCohortId = "";
            _cohortGrowerIds = null;
        }
    }

    private async Task LoadCohortMembersAsync()
    {
        var cohortId = ParseNullableInt(_selectedCohortId);
        if (cohortId.HasValue)
        {
            var growerCohorts = await CohortService.GetGrowerCohortsAsync(cohortId.Value) ?? new();
            _cohortGrowerIds = new HashSet<int>(growerCohorts.Select(gc => gc.GrowerId));
        }
        else
        {
            _cohortGrowerIds = null;
        }
    }

    private void RebuildGrowerOptions()
    {
        IEnumerable<Models.Grower> filtered = _growers ?? new List<Models.Grower>();

        var villageId = ParseNullableInt(_selectedVillageId);
        if (villageId.HasValue)
        {
            filtered = filtered.Where(g => g.VillageId == villageId.Value);
        }

        if (_cohortGrowerIds != null)
        {
            filtered = filtered.Where(g => _cohortGrowerIds.Contains(g.GrowerId));
        }

        _growerOptions = filtered.OrderBy(g => g.GrowerName).ToList();

        if (_growerId != 0 && !_growerOptions.Any(g => g.GrowerId == _growerId))
        {
            _growerId = 0;
        }
    }

    private async Task OnVillageChanged()
    {
        _selectedCohortId = "";
        _cohortGrowerIds = null;
        _growerId = 0;
        await LoadCohortOptionsAsync();
        RebuildGrowerOptions();
        await LoadTreesAsync();
    }

    private async Task OnCohortChanged()
    {
        _growerId = 0;
        await LoadCohortMembersAsync();
        RebuildGrowerOptions();
        await LoadTreesAsync();
    }

    private static int? ParseNullableInt(string value)
    {
        return int.TryParse(value, out int result) ? result : null;
    }

    private async Task LoadTreesAsync()
    {
        if (_treesLoadedForGrowerId.HasValue && _treesLoadedForGrowerId.Value != _growerId)
        {
            ResetProblemsForGrowerChange();
        }

        if (_growerId == 0)
        {
            _trees = new();
            _treesLoadedForGrowerId = _growerId;
            _growerAssessmentHistory = new();
            _assessmentFrequencyDays = 30;
            RecalculateAssessmentDateProximityWarning();
            return;
        }

        var orchards = await OrchardService.GetOrchardsForGrowerAsync(_growerId);
        _trees = orchards.SelectMany(o => o.Trees).ToList();
        _treesLoadedForGrowerId = _growerId;

        _growerAssessmentHistory = await AssessmentService.GetAssessmentsByGrowerAsync(_growerId) ?? new();

        var cohorts = await CohortService.GetCohortsByGrowerAsync(_growerId) ?? new();
        var mostRecentActivation = cohorts
            .Where(c => c.ActivatedOn.HasValue)
            .OrderByDescending(c => c.ActivatedOn)
            .FirstOrDefault();
        _assessmentFrequencyDays = mostRecentActivation?.AssessmentFrequencyDays ?? 30;

        RecalculateAssessmentDateProximityWarning();
    }

    private void OnAssessmentDateChanged() => RecalculateAssessmentDateProximityWarning();

    private void RecalculateAssessmentDateProximityWarning()
    {
        var selectedDate = _assessmentDate.Date;
        var candidates = _growerAssessmentHistory.Where(a => a.AssessmentId != _id).ToList();

        if (candidates.Count == 0)
        {
            _assessmentDateProximityDayDiff = null;
            _assessmentDateProximityNearestDate = null;
            _assessmentDateProximityIsDuplicate = false;
            return;
        }

        var nearest = candidates.OrderBy(a => Math.Abs((a.AssessmentDate.Date - selectedDate).Days)).First();
        _assessmentDateProximityDayDiff = Math.Abs((nearest.AssessmentDate.Date - selectedDate).Days);
        _assessmentDateProximityNearestDate = nearest.AssessmentDate.Date;
        _assessmentDateProximityIsDuplicate = _assessmentDateProximityDayDiff == 0;
    }

    private async Task LoadGrowerModuleAsync()
    {
        try
        {
            var siteModules = await ModuleService.GetModulesAsync(PageState.Site.SiteId);
            var growerModule = siteModules?
                .FirstOrDefault(m => m.ModuleDefinitionName.StartsWith("OpenEug.TenTrees.Module.Grower"));
            if (growerModule != null)
            {
                _growerModuleId = growerModule.ModuleId;
                var page = PageState.Pages?.FirstOrDefault(p => p.PageId == growerModule.PageId);
                _growerPagePath = page?.Path;
            }
        }
        catch (Exception ex)
        {
            await logger.LogError(ex, "Error Loading Grower Module {Error}", ex.Message);
        }
    }

    private void ToggleProblem(int treeId, string problemType, bool isChecked)
    {
        if (isChecked)
        {
            if (!_problems.Any(p => p.TreeId == treeId && p.ProblemType == problemType))
            {
                _problems.Add(new Models.AssessmentProblem
                {
                    AssessmentId = _id,
                    TreeId = treeId,
                    ProblemType = problemType
                });
            }
        }
        else
        {
            _problems.RemoveAll(p => p.TreeId == treeId && p.ProblemType == problemType);
        }
    }

    private void SetNeedsHelp(int treeId, bool needsHelp)
    {
        foreach (var p in _problems.Where(p => p.TreeId == treeId))
            p.NeedsHelp = needsHelp;
    }

    private void ApplyLegacyProblemFlags(Models.Assessment assessment)
    {
        assessment.HasBrokenBranches = _problems.Any(p => p.ProblemType == AssessmentProblemTypes.BrokenBranches);
        assessment.HasYellowLeaves = _problems.Any(p => p.ProblemType == AssessmentProblemTypes.YellowLeaves);
        assessment.HasLosingLeaves = _problems.Any(p => p.ProblemType == AssessmentProblemTypes.LosingLeaves);
        assessment.HasLookDry = _problems.Any(p => p.ProblemType == AssessmentProblemTypes.LookDry);
        assessment.HasPests = _problems.Any(p => p.ProblemType == AssessmentProblemTypes.Pests);
        assessment.NeedsHelp = _problems.Any(p => p.NeedsHelp);
    }

    private async Task LoadExistingPhotosAsync()
    {
        _existingPhotos = await AssessmentService.GetPhotosByAssessmentAsync(_id) ?? new List<AssessmentPhotoDto>();
    }

    private async Task OnPhotoUploadedAsync(int fileId)
    {
        _isPhotoBusy = true;
        try
        {
            if (_existingPhotos.Count >= AssessmentPhotoRules.MaxPhotosPerAssessment)
            {
                await FileService.DeleteFileAsync(fileId);
                AddModuleMessage(string.Format(Localizer["Message.PhotoLimit"], AssessmentPhotoRules.MaxPhotosPerAssessment), MessageType.Warning);
                return;
            }

            var file = await FileService.GetFileAsync(fileId);
            if (file == null || !AssessmentPhotoRules.IsAllowedExtension(file.Extension))
            {
                await FileService.DeleteFileAsync(fileId);
                AddModuleMessage(string.Format(Localizer["Message.PhotoInvalidType"], file?.Name ?? fileId.ToString()), MessageType.Warning);
                return;
            }

            var created = await AssessmentService.AddPhotoAsync(new Models.AssessmentPhoto
            {
                AssessmentId = _id,
                FileId = fileId
            });
            if (created == null)
            {
                await FileService.DeleteFileAsync(fileId);
                AddModuleMessage(Localizer["Message.PhotoSaveError"], MessageType.Error);
                return;
            }

            await LoadExistingPhotosAsync();
            AddModuleMessage(Localizer["Message.PhotoSaveSuccess"], MessageType.Success);
        }
        catch (Exception ex)
        {
            await logger.LogError(ex, "Error Linking Oqtane Assessment File {FileId} {Error}", fileId, ex.Message);
            try
            {
                await FileService.DeleteFileAsync(fileId);
            }
            catch (Exception cleanupEx)
            {
                await logger.LogError(cleanupEx, "Error Removing Unlinked Oqtane Assessment File {FileId} {Error}", fileId, cleanupEx.Message);
            }
            AddModuleMessage(Localizer["Message.PhotoSaveError"], MessageType.Error);
        }
        finally
        {
            _isPhotoBusy = false;
        }
    }

    private async Task DeleteExistingPhotoAsync(AssessmentPhotoDto photo)
    {
        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", Localizer["Photo.DeleteConfirm"].Value);
        if (!confirmed)
        {
            return;
        }

        _isPhotoBusy = true;
        try
        {
            if (await AssessmentService.DeletePhotoAsync(photo.AssessmentPhotoId))
            {
                _existingPhotos.Remove(photo);
                AddModuleMessage(Localizer["Message.PhotoDeleteSuccess"], MessageType.Success);
            }
            else
            {
                AddModuleMessage(Localizer["Message.PhotoDeleteError"], MessageType.Error);
            }
        }
        catch (Exception ex)
        {
            await logger.LogError(ex, "Error Deleting Assessment Photo {AssessmentPhotoId} {Error}", photo.AssessmentPhotoId, ex.Message);
            AddModuleMessage(Localizer["Message.PhotoDeleteError"], MessageType.Error);
        }
        finally
        {
            _isPhotoBusy = false;
        }
    }

    private void AddPendingNote()
    {
        if (string.IsNullOrWhiteSpace(_newNoteText))
        {
            return;
        }

        var type = _newNoteType == AssessmentNoteTypes.HomeVisit
            ? AssessmentNoteTypes.HomeVisit
            : AssessmentNoteTypes.General;

        _pendingNotes.Add(new Models.AssessmentNote
        {
            NoteType = type,
            Text = _newNoteText.Trim()
        });

        _newNoteText = string.Empty;
        _newNoteType = AssessmentNoteTypes.General;
    }

    private void RemovePendingNote(int index)
    {
        if (index < 0 || index >= _pendingNotes.Count) return;
        _pendingNotes.RemoveAt(index);
    }

    private async Task<bool> PersistPendingNotesAsync(int assessmentId)
    {
        if (_pendingNotes.Count == 0) return true;

        var failedNotes = new List<Models.AssessmentNote>();

        foreach (var note in _pendingNotes)
        {
            note.AssessmentId = assessmentId;
            try
            {
                await AssessmentService.AddNoteAsync(note);
            }
            catch (Exception ex)
            {
                await logger.LogError(ex, "Error Saving Assessment Note {AssessmentId} {Error}", assessmentId, ex.Message);
                failedNotes.Add(note);
            }
        }

        _pendingNotes.Clear();
        _pendingNotes.AddRange(failedNotes);

        if (_pendingNotes.Count > 0)
        {
            AddModuleMessage(Localizer["Message.NoteSaveError"], MessageType.Error);
            return false;
        }

        return true;
    }
}
