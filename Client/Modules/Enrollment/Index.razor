@using OpenEug.TenTrees.Module.Enrollment.Services
@using OpenEug.TenTrees.Module.Village.Services
@using OpenEug.TenTrees.Models
@using System.Linq
@page "/Enrollment"

@namespace OpenEug.TenTrees.Module.Enrollment
@inherits ModuleBase
@inject IEnrollmentService EnrollmentService
@inject IVillageService VillageService
@inject NavigationManager NavigationManager
@inject IStringLocalizer<Index> Localizer

<div class="container">
    <!-- Action Buttons -->
    <div class="d-flex gap-2 mb-3">
        <ActionLink Action="BasicInfo" Security="SecurityAccessLevel.View" Text="Add Enrollment" ResourceKey="Add" Class="btn btn-primary" />
    </div>

    <!-- Filter Section -->
    <div class="row mb-3">
        <div class="col-md-4">
            <label for="statusFilter">@Localizer["Filter.Status"]</label>
            <select id="statusFilter" class="form-select" @bind="_statusFilter">
                <option value="">@Localizer["Filter.AllStatuses"]</option>
                <option value="@EnrollmentStatus.Pending">@Localizer["EnrollmentStatus.Pending"]</option>
                <option value="@EnrollmentStatus.Approved">@Localizer["EnrollmentStatus.Approved"]</option>
                <option value="@EnrollmentStatus.Rejected">@Localizer["EnrollmentStatus.Rejected"]</option>
            </select>
        </div>
        <div class="col-md-4">
            <label for="villageFilter">@Localizer["Filter.Village"]</label>
            <select id="villageFilter" class="form-select" @bind="_villageFilter">
                <option value="">@Localizer["Filter.AllVillages"]</option>
                @if (_villages != null)
                {
                    @foreach (var village in _villages)
                    {
                        <option value="@village.VillageId">@village.VillageName</option>
                    }
                }
            </select>
        </div>
        <div class="col-md-4 d-flex align-items-end gap-2">
            <button class="btn btn-primary w-100" @onclick="ApplyFiltersAndRefresh">Filter</button>
            <button class="btn btn-secondary w-100" @onclick="ClearFilters">@Localizer["Action.ClearFilters"]</button>
        </div>
    </div>

    <!-- Status Summary -->
    @if (_summary != null)
    {
        <div class="row mb-3">
            <div class="col-md-3">
                <button type="button" class="card text-center bg-warning-subtle w-100" @onclick="() => ApplyStatusFilter(EnrollmentStatus.Pending.ToString())">
                    <div class="card-body">
                        <h5 class="card-title">@_summary.Pending</h5>
                        <p class="card-text">@Localizer["EnrollmentStatus.Pending"]</p>
                    </div>
                </button>
            </div>
            <div class="col-md-3">
                <button type="button" class="card text-center bg-success-subtle w-100" @onclick="() => ApplyStatusFilter(EnrollmentStatus.Approved.ToString())">
                    <div class="card-body">
                        <h5 class="card-title">@_summary.Approved</h5>
                        <p class="card-text">@Localizer["EnrollmentStatus.Approved"]</p>
                    </div>
                </button>
            </div>
            <div class="col-md-3">
                <button type="button" class="card text-center bg-danger-subtle w-100" @onclick="() => ApplyStatusFilter(EnrollmentStatus.Rejected.ToString())">
                    <div class="card-body">
                        <h5 class="card-title">@_summary.Rejected</h5>
                        <p class="card-text">@Localizer["EnrollmentStatus.Rejected"]</p>
                    </div>
                </button>
            </div>
            <div class="col-md-3">
                <button type="button" class="card text-center bg-primary-subtle w-100" @onclick="() => ApplyStatusFilter(string.Empty)">
                    <div class="card-body">
                        <h5 class="card-title">@_summary.Total</h5>
                        <p class="card-text">@Localizer["Summary.Total"]</p>
                    </div>
                </button>
            </div>
        </div>
    }

    <!-- Enrollments List -->
    @if (_Enrollments == null)
    {
        <p><em>@Localizer["Message.Loading"]</em></p>
    }
    else if (@_Enrollments.Count == 0)
    {
        <p>@Localizer["Message.DisplayNone"]</p>
    }
    else
    {
        <Pager Items="@_Enrollments"
               Format="Table"
               Class="table table-striped"
               PageSize="@_pageSize.ToString()"
               CurrentPage="@_currentPage.ToString()"
               OnPageChange="HandlePageChange">
            <Header>
                <th style="width: 1px;"><span class="visually-hidden">Edit</span></th>
                <th style="width: 1px;"><span class="visually-hidden">Delete</span></th>
                <th>@Localizer["Grower"]</th>
                <th>@Localizer["Mentor"]</th>
                <th>@Localizer["Village"]</th>
                <th>@Localizer["Status"]</th>
                <th>@Localizer["Column.GrowerStatus"]</th>
                <th>@Localizer["Column.PhotoConsent"]</th>
                <th>@Localizer["Column.Actions"]</th>
                <th style="width: 1px;"><span class="visually-hidden">@Localizer["Column.PhotoConsentAction"]</span></th>
            </Header>
            <Row>
                @{
                    var rowClass = context.EnrollmentStatus == EnrollmentStatus.Pending ? "table-warning" :
                                   context.EnrollmentStatus == EnrollmentStatus.Rejected ? "table-danger" : "";
                }

                <tr class="@rowClass">
                    <td><ActionLink Action="Edit" Parameters="@($"id={context.EnrollmentId}&returnurl={Uri.EscapeDataString(GetReturnUrl())}")" ResourceKey="Edit" /></td>
                    <td><ActionDialog Header="Delete Enrollment" Message="Are You Sure You Wish To Delete This Enrollment?" Action="Delete" Security="SecurityAccessLevel.Edit" Class="btn btn-danger" OnClick="@(async () => await Delete(context))" ResourceKey="Delete" Id="@context.EnrollmentId.ToString()" /></td>
                    <td>@context.GrowerName</td>
                    <td>@context.MentorUserName</td>
                    <td>@(string.IsNullOrEmpty(context.VillageName) ? Localizer["UnknownVillage"] : context.VillageName)</td>
                    <td>
                        <span class="badge @GetEnrollmentStatusBadgeClass(context.EnrollmentStatus)">
                            @GetEnrollmentStatusText(context.EnrollmentStatus)
                        </span>
                    </td>
                    <td>
                        <span class="badge @GetGrowerStatusBadgeClass(context.GrowerStatus)">
                            @GetGrowerStatusText(context.GrowerStatus)
                        </span>
                    </td>
                    <td>
                        <span class="badge @GetPhotoConsentBadgeClass(context.PhotoConsentLevel)">
                            @GetPhotoConsentText(context.PhotoConsentLevel)
                        </span>
                    </td>
                    <td class="text-nowrap">
                        @if (context.EnrollmentStatus == EnrollmentStatus.Pending)
                        {
                            <div class="d-inline-flex gap-1 align-items-center">
                                <button class="btn btn-sm btn-success"
                                        aria-label="@Localizer["Action.Approve"] @context.GrowerName"
                                        @onclick="() => ApproveInline(context.EnrollmentId)">
                                    <span class="oi oi-check" aria-hidden="true"></span>
                                </button>
                                <button class="btn btn-sm btn-danger"
                                        aria-label="@Localizer["Action.Reject"] @context.GrowerName"
                                        @onclick="() => RejectInline(context.EnrollmentId)">
                                    <span class="oi oi-x" aria-hidden="true"></span>
                                </button>
                            </div>
                        }
                    </td>
                    <td>
                        @if (context.EnrollmentStatus == EnrollmentStatus.Approved)
                        {
                            <ActionLink Action="PhotoConsent"
                                        Parameters="@($"id={context.EnrollmentId}")"
                                        ResourceKey="PhotoConsent" />
                        }
                    </td>
                </tr>
            </Row>
        </Pager>
    }
</div>

@code {
    public override List<Resource> Resources => new List<Resource>()
    {
        new Stylesheet(ModulePath() + "Module.css"),
        new Script(ModulePath() + "Module.js")
    };

    private List<Models.EnrollmentListViewModel> _Enrollments;
    private List<Models.EnrollmentListViewModel> _allEnrollments;
    private List<Models.Village> _villages;
    private EnrollmentStatusSummary _summary;
    private string _statusFilter = "";
    private string _villageFilter = "";
    private bool _isLoading = false;
    private int _currentPage = 1;
    private const int _pageSize = 20;

    protected override async Task OnParametersSetAsync()
    {
        if (_isLoading) return;
        _isLoading = true;

        try
        {
            _statusFilter = PageState.QueryString.GetValueOrDefault("status", "");
            _villageFilter = PageState.QueryString.GetValueOrDefault("villageId", "");
            _currentPage = ParsePage(PageState.QueryString.GetValueOrDefault("page"));
            await LoadVillagesAsync();
            _allEnrollments = await EnrollmentService.GetEnrollmentListViewModelsAsync()
                ?? new List<Models.EnrollmentListViewModel>();
            ApplyFilters();
            CalculateSummary();
        }
        catch (Exception ex)
        {
            await logger.LogError(ex, "Error Loading Enrollment {Error}", ex.Message);
            AddModuleMessage(Localizer["Message.LoadError"], MessageType.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task LoadVillagesAsync()
    {
        _villages = UserSecurity.IsAuthorized(PageState.User, AppRoleNames.TenTreesAdmin)
            ? await VillageService.GetVillagesAsync()
            : (await VillageService.GetActiveVillagesAsync())
                .OrderBy(v => v.VillageName)
                .ToList();
    }

    private async Task LoadEnrollmentsAsync()
    {
        _allEnrollments = await EnrollmentService.GetEnrollmentListViewModelsAsync()
            ?? new List<Models.EnrollmentListViewModel>();
        ApplyFilters();
        CalculateSummary();
        StateHasChanged();
    }

    private void ApplyFilters()
    {
        _Enrollments = _allEnrollments;

        // Apply status filter
        if (!string.IsNullOrEmpty(_statusFilter))
        {
            var status = (EnrollmentStatus)Enum.Parse(typeof(EnrollmentStatus), _statusFilter);
            _Enrollments = _Enrollments.Where(e => e.EnrollmentStatus == status).ToList();
        }

        // Apply village filter
        if (!string.IsNullOrEmpty(_villageFilter) && int.TryParse(_villageFilter, out var villageId))
        {
            _Enrollments = _Enrollments.Where(e => e.VillageId == villageId).ToList();
        }
    }

    private void CalculateSummary()
    {
        _summary = new EnrollmentStatusSummary
        {
            Pending = _allEnrollments.Count(e => e.EnrollmentStatus == EnrollmentStatus.Pending),
            Approved = _allEnrollments.Count(e => e.EnrollmentStatus == EnrollmentStatus.Approved),
            Rejected = _allEnrollments.Count(e => e.EnrollmentStatus == EnrollmentStatus.Rejected),
            Total = _allEnrollments.Count
        };
    }

    private void ApplyFiltersAndRefresh()
    {
        _currentPage = 1;
        NavigateWithFilters();
    }

    private void ClearFilters()
    {
        _statusFilter = "";
        _villageFilter = "";
        _currentPage = 1;
        NavigationManager.NavigateTo(NavigateUrl());
    }

    private void ApplyStatusFilter(string status)
    {
        _statusFilter = status;
        _currentPage = 1;
        NavigateWithFilters();
    }

    private void HandlePageChange(int page)
    {
        if (page == _currentPage)
        {
            return;
        }

        _currentPage = page;
        NavigateWithFilters(includePage: true);
    }

    private void NavigateWithFilters(bool includePage = false)
    {
        NavigationManager.NavigateTo(NavigateUrl(PageState.Page.Path, BuildFilterQueryString(includePage)));
    }

    private string BuildFilterQueryString(bool includePage = false)
    {
        var parts = new List<string>();
        if (!string.IsNullOrEmpty(_statusFilter)) parts.Add($"status={Uri.EscapeDataString(_statusFilter)}");
        if (!string.IsNullOrEmpty(_villageFilter)) parts.Add($"villageId={Uri.EscapeDataString(_villageFilter)}");
        if (includePage && _currentPage > 1) parts.Add($"page={_currentPage}");
        return string.Join("&", parts);
    }

    private string GetReturnUrl()
    {
        return NavigateUrl(PageState.Page.Path, BuildFilterQueryString(includePage: true));
    }

    private static int ParsePage(string value)
    {
        return int.TryParse(value, out var page) && page > 0 ? page : 1;
    }

    private async Task Delete(Models.EnrollmentListViewModel Enrollment)
    {
        try
        {
            await EnrollmentService.DeleteEnrollmentAsync(Enrollment.EnrollmentId, ModuleState.ModuleId);
            await logger.LogInformation("Enrollment Deleted {Enrollment}", Enrollment);
            await LoadEnrollmentsAsync();
        }
        catch (Exception ex)
        {
            await logger.LogError(ex, "Error Deleting Enrollment {Enrollment} {Error}", Enrollment, ex.Message);
            AddModuleMessage(Localizer["Message.DeleteError"], MessageType.Error);
        }
    }

    private async Task UpdateEnrollmentStatusInline(
        int enrollmentId,
        Models.EnrollmentStatus status,
        string successLogMessageTemplate,
        string errorLogMessageTemplate,
        string toastLocalizationKey,
        MessageType toastMessageType)
    {
        try
        {
            var enrollment = await EnrollmentService.GetEnrollmentAsync(enrollmentId);
            enrollment.Status = status;
            await EnrollmentService.UpdateEnrollmentAsync(enrollment);
            await logger.LogInformation(successLogMessageTemplate, enrollmentId);
            AddModuleMessage(Localizer[toastLocalizationKey], toastMessageType);
            await LoadEnrollmentsAsync();
        }
        catch (Exception ex)
        {
            await logger.LogError(ex, errorLogMessageTemplate, enrollmentId, ex.Message);
            AddModuleMessage(Localizer["Message.StatusChangeError"], MessageType.Error);
        }
    }

    private Task ApproveInline(int enrollmentId)
    {
        return UpdateEnrollmentStatusInline(
            enrollmentId,
            Models.EnrollmentStatus.Approved,
            "Enrollment {EnrollmentId} Approved",
            "Error Approving Enrollment {EnrollmentId} {Error}",
            "Message.Approved",
            MessageType.Success);
    }

    private Task RejectInline(int enrollmentId)
    {
        return UpdateEnrollmentStatusInline(
            enrollmentId,
            Models.EnrollmentStatus.Rejected,
            "Enrollment {EnrollmentId} Rejected",
            "Error Rejecting Enrollment {EnrollmentId} {Error}",
            "Message.Rejected",
            MessageType.Warning);
    }
    private string GetEnrollmentStatusBadgeClass(Models.EnrollmentStatus status)
    {
        return status switch
        {
            Models.EnrollmentStatus.Pending => "bg-warning",
            Models.EnrollmentStatus.Approved => "bg-success",
            Models.EnrollmentStatus.Rejected => "bg-danger",
            _ => "bg-secondary"
        };
    }

    private string GetEnrollmentStatusText(Models.EnrollmentStatus status)
    {
        return status switch
        {
            Models.EnrollmentStatus.Pending => Localizer["EnrollmentStatus.Pending"],
            Models.EnrollmentStatus.Approved => Localizer["EnrollmentStatus.Approved"],
            Models.EnrollmentStatus.Rejected => Localizer["EnrollmentStatus.Rejected"],
            _ => status.ToString()
        };
    }

    private string GetGrowerStatusBadgeClass(GrowerStatus status)
    {
        return status switch
        {
            GrowerStatus.Active => "bg-success",
            GrowerStatus.Inactive => "bg-warning",
            GrowerStatus.Exited => "bg-secondary",
            _ => "bg-light"
        };
    }

    private string GetGrowerStatusText(GrowerStatus status)
    {
        return status switch
        {
            GrowerStatus.Active => Localizer["GrowerStatus.Active"],
            GrowerStatus.Inactive => Localizer["GrowerStatus.Inactive"],
            GrowerStatus.Exited => Localizer["GrowerStatus.Exited"],
            _ => status.ToString()
        };
    }

    private string GetPhotoConsentBadgeClass(PhotoConsentLevel level)
    {
        return level switch
        {
            PhotoConsentLevel.Full => "bg-success",
            PhotoConsentLevel.Limited => "bg-warning text-dark",
            PhotoConsentLevel.None => "bg-danger",
            _ => "bg-secondary"
        };
    }

    private string GetPhotoConsentText(PhotoConsentLevel level)
    {
        return level switch
        {
            PhotoConsentLevel.Full => Localizer["ConsentLevel.Full"],
            PhotoConsentLevel.Limited => Localizer["ConsentLevel.Limited"],
            PhotoConsentLevel.None => Localizer["ConsentLevel.None"],
            _ => Localizer["ConsentLevel.NotCaptured"]
        };
    }
}
