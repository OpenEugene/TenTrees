@using OpenEug.TenTrees.Module.TreeType.Services
@page "/TreeType"

@namespace OpenEug.TenTrees.Module.TreeType
@inherits ModuleBase
@inject ITreeTypeService TreeTypeService
@inject NavigationManager NavigationManager
@inject IStringLocalizer<Index> Localizer

@if (_treeTypes == null)
{
    <p role="status"><em>@Localizer["Message.Loading"]</em></p>
}
else
{
    <ActionLink Action="Add" Text="@Localizer["Add"]" ResourceKey="Add" Class="btn btn-primary mb-3" Security="SecurityAccessLevel.Edit" />
    <br />
    @if (_treeTypes.Count != 0)
    {
        <Pager Items="@_treeTypes">
            <Header>
                <th style="width: 1px;"><span class="visually-hidden">@Localizer["Column.Actions"]</span></th>
                <th style="width: 1px;"><span class="visually-hidden">@Localizer["Column.Actions"]</span></th>
                <th>@Localizer["Column.Name"]</th>
                <th>@Localizer["Column.Category"]</th>
                <th>@Localizer["Column.SortOrder"]</th>
                <th>@Localizer["Column.Status"]</th>
            </Header>
            <Row>
                <td><ActionLink Action="Edit" Parameters="@($"id={context.TreeTypeId}")" ResourceKey="Edit" /></td>
                <td><ActionDialog Header="@Localizer["Dialog.DeleteTreeType.Header"]" Message="@Localizer["Dialog.DeleteTreeType.Message"]" Action="Delete" Security="SecurityAccessLevel.Edit" Class="btn btn-danger" OnClick="@(async () => await Delete(context))" ResourceKey="Delete" /></td>
                <td>@context.Name</td>
                <td>@context.Category</td>
                <td>@context.SortOrder</td>
                <td>@(context.IsActive ? Localizer["Active"] : Localizer["Inactive"])</td>
            </Row>
        </Pager>
    }
    else
    {
        <p>@Localizer["Message.NoTreeTypes"]</p>
    }
}

@code {

    private List<Models.TreeType> _treeTypes;

    protected override async Task OnParametersSetAsync()
    {
        try
        {
            _treeTypes = await TreeTypeService.GetTreeTypesAsync();
        }
        catch (Exception ex)
        {
            await logger.LogError(ex, "Error Loading Tree Types {Error}", ex.Message);
            AddModuleMessage(Localizer["Message.LoadError"], MessageType.Error);
        }
    }

    private async Task Delete(Models.TreeType treeType)
    {
        try
        {
            await TreeTypeService.DeleteTreeTypeAsync(treeType.TreeTypeId);
            await logger.LogInformation("TreeType Deleted {TreeType}", treeType.Name);
            _treeTypes = await TreeTypeService.GetTreeTypesAsync();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            await logger.LogError(ex, "Error Deleting Tree Type {TreeType} {Error}", treeType.Name, ex.Message);
            AddModuleMessage(Localizer["Message.DeleteError"], MessageType.Error);
        }
    }
}
