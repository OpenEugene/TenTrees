@using OpenEug.TenTrees.Module.Grower.Services
@using OpenEug.TenTrees.Module.Village.Services
@using OpenEug.TenTrees.Module.Cohort.Services
@using OpenEug.TenTrees.Models
@page "/Grower"

@namespace OpenEug.TenTrees.Module.Grower
@inherits ModuleBase
@inject IGrowerService GrowerService
@inject IVillageService VillageService
@inject ICohortService CohortService
@inject NavigationManager NavigationManager
@inject IStringLocalizer<Index> Localizer

<div class="container">
    <!-- Filter / Sort bar -->
    <div class="d-flex flex-wrap align-items-end justify-content-between gap-2 mb-3">
        <!-- Filters (left) -->
        <div class="d-flex flex-wrap gap-2">
            <div>
                <label for="statusFilter" class="form-label">@Localizer["Filter.Status"]</label>
                <select id="statusFilter" class="form-select" @bind="_statusFilter" @bind:after="NavigateWithFilters">
                    <option value="">@Localizer["Filter.AllStatuses"]</option>
                    <option value="@GrowerStatus.Active">@Localizer["Status.Active"]</option>
                    <option value="@GrowerStatus.Inactive">@Localizer["Status.Inactive"]</option>
                    <option value="@GrowerStatus.Exited">@Localizer["Status.Exited"]</option>
                </select>
            </div>
            <div>
                <label for="villageFilter" class="form-label">@Localizer["Filter.Village"]</label>
                <select id="villageFilter" class="form-select" @bind="_villageFilter" @bind:after="NavigateWithFilters">
                    <option value="">@Localizer["Filter.AllVillages"]</option>
                    @if (_villages != null)
                    {
                        @foreach (var village in _villages)
                        {
                            <option value="@village.VillageId">@village.VillageName</option>
                        }
                    }
                </select>
            </div>
            <div>
                <label for="cohortFilter" class="form-label">Cohort</label>
                <select id="cohortFilter" class="form-select" @bind="_cohortFilter" @bind:after="LoadGrowersAsync">
                    <option value="">All Cohorts</option>
                    @foreach (var cohort in _cohorts)
                    {
                        <option value="@cohort.CohortId">@cohort.Name</option>
                    }
                </select>
            </div>
            <div>
                <label for="nameFilter" class="form-label">Name</label>
                <input id="nameFilter" type="text" class="form-control" @bind="_nameFilter" @bind:event="oninput" @bind:after="NavigateWithFilters" placeholder="Search…" />
            </div>
        </div>
        <!-- Sort (right) -->
        <div class="d-flex align-items-end gap-2">
            <div>
                <label for="sortBy" class="form-label">Sort by</label>
                <select id="sortBy" class="form-select" @bind="_sortBy" @bind:after="NavigateWithFilters">
                    <option value="lastname">Last Name</option>
                    <option value="firstname">First Name</option>
                    <option value="village">Village</option>
                    <option value="status">Status</option>
                    <option value="exitdate">Exit Date</option>
                </select>
            </div>
            <button class="btn btn-outline-secondary" @onclick="ToggleSortDirAndNavigate" title="@(_sortAsc ? "Ascending" : "Descending")" aria-label="Toggle sort direction">
                <span class="oi @(_sortAsc ? "oi-sort-ascending" : "oi-sort-descending")" aria-hidden="true"></span>
            </button>
        </div>
    </div>

    <!-- Status Summary -->
    @if (_summary != null)
    {
        <div class="row mb-3">
            <div class="col-md-3">
                <button type="button" class="card text-center bg-success-subtle w-100" @onclick="() => ApplyStatusFilter(GrowerStatus.Active.ToString())">
                    <div class="card-body">
                        <h5 class="card-title">@_summary.Active</h5>
                        <p class="card-text">@Localizer["Status.Active"]</p>
                    </div>
                </button>
            </div>
            <div class="col-md-3">
                <button type="button" class="card text-center bg-warning-subtle w-100" @onclick="() => ApplyStatusFilter(GrowerStatus.Inactive.ToString())">
                    <div class="card-body">
                        <h5 class="card-title">@_summary.Inactive</h5>
                        <p class="card-text">@Localizer["Status.Inactive"]</p>
                    </div>
                </button>
            </div>
            <div class="col-md-3">
                <button type="button" class="card text-center bg-secondary-subtle w-100" @onclick="() => ApplyStatusFilter(GrowerStatus.Exited.ToString())">
                    <div class="card-body">
                        <h5 class="card-title">@_summary.Exited</h5>
                        <p class="card-text">@Localizer["Status.Exited"]</p>
                    </div>
                </button>
            </div>
            <div class="col-md-3">
                <button type="button" class="card text-center bg-primary-subtle w-100" @onclick="() => ApplyStatusFilter(String.Empty)">
                    <div class="card-body">
                        <h5 class="card-title">@_summary.Total</h5>
                        <p class="card-text">@Localizer["Summary.Total"]</p>
                    </div>
                </button>
            </div>
        </div>
    }

    <!-- Growers List -->
    @if (_growers == null)
    {
        <p><em>@Localizer["Message.Loading"]</em></p>
    }
    else if (_growers.Count == 0)
    {
        <p>@Localizer["Message.NoGrowers"]</p>
    }
    else
    {
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>@Localizer["Column.GrowerName"]</th>
                    <th>@Localizer["Column.Village"]</th>
                    <th>@Localizer["Column.Status"]</th>
                    <th>@Localizer["Column.ExitDate"]</th>
                    <th>@Localizer["Column.Actions"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var grower in SortedGrowers())
                {
                    var rowClass = grower.Status == GrowerStatus.Inactive ? "table-warning" :
                                   grower.Status == GrowerStatus.Exited ? "table-secondary" : "";
                    
                    <tr class="@rowClass">
                        <td>@grower.GrowerName</td>
                        <td>@GetVillageName(grower.VillageId)</td>
                        <td>
                            <span class="badge @GetStatusBadgeClass(grower.Status)">
                                @GetStatusText(grower.Status)
                            </span>
                        </td>
                        <td>@(grower.ExitDate?.ToString("yyyy-MM-dd") ?? "-")</td>
                        <td>
                            <div class="d-flex gap-1">
                                <ActionLink Action="Edit" 
                                           Parameters="@($"id={grower.GrowerId}&{BuildFilterQueryString()}")"
                                           Text="Edit" 
                                           ResourceKey="EditGrower" 
                                           Class="btn btn-sm btn-primary" />
                                <ActionDialog Header="Delete Grower"
                                             Message="@($"Are you sure you wish to delete {grower.GrowerName}? This action cannot be undone.")"
                                             Action="Delete"
                                             Security="SecurityAccessLevel.Edit"
                                             Class="btn btn-sm btn-danger"
                                             OnClick="@(async () => await DeleteGrower(grower))"
                                             ResourceKey="DeleteGrower"
                                             Id="@grower.GrowerId.ToString()" />
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@code {
    private List<Models.Grower> _growers;
    private List<Models.Village> _villages;
    private List<Models.Cohort> _cohorts = new();
    private HashSet<int> _cohortGrowerIds;     // null = no cohort filter
    private GrowerStatusSummary _summary;
    private string _statusFilter = "";
    private string _villageFilter = "";
    private string _cohortFilter = "";
    private string _nameFilter = "";
    private bool _isLoading = false;
    private string _sortBy = "lastname";
    private bool _sortAsc = true;

    private void ToggleSortDir() => _sortAsc = !_sortAsc;

    private void ToggleSortDirAndNavigate()
    {
        _sortAsc = !_sortAsc;
        NavigateWithFilters();
    }

    protected override async Task OnParametersSetAsync()
    {
        // In-flight re-entry guard: prevents a concurrent second invocation
        // (from cascading parameter updates) from racing with the first load and
        // leaving _cohorts empty (issue #102). Unlike a permanent flag, this
        // resets after each load so subsequent filter navigations can re-trigger
        // OnParametersSetAsync and pick up the new query-string values.
        if (_isLoading) return;
        _isLoading = true;

        try
        {
            _statusFilter = PageState.QueryString.GetValueOrDefault("status", "");
            _villageFilter = PageState.QueryString.GetValueOrDefault("villageId", "");
            _nameFilter = PageState.QueryString.GetValueOrDefault("name", "");
            _sortBy = PageState.QueryString.GetValueOrDefault("sortBy", "lastname");
            _sortAsc = !PageState.QueryString.ContainsKey("sortDesc");
            await LoadVillagesAsync();
            await LoadCohortsForMentorAsync();
            await LoadSummaryAsync();
            await LoadGrowersAsync();
        }
        catch (Exception ex)
        {
            await logger.LogError(ex, "Error Loading Growers {Error}", ex.Message);
            AddModuleMessage(Localizer["Message.LoadError"], MessageType.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task LoadVillagesAsync()
    {
        _villages = UserSecurity.IsAuthorized(PageState.User, AppRoleNames.TenTreesAdmin)
            ? await VillageService.GetVillagesAsync()
            : await VillageService.GetActiveVillagesAsync();
    }

    // For mentors, pre-load only their assigned cohorts and restrict grower list accordingly.
    // Admins, Educators, and Project Managers see all cohorts (optionally filtered by village).
    private async Task LoadCohortsForMentorAsync()
    {
        // Isolate cohort loading so a failure (or empty result) doesn't cause the
        // rest of the grower page to fall through to its outer catch block and
        // leave the user with a fully-unusable screen — see issue #102.
        try
        {
            bool isMentorOnly = UserSecurity.IsAuthorized(PageState.User, AppRoleNames.Mentor)
                && !UserSecurity.IsAuthorized(PageState.User, AppRoleNames.TenTreesAdmin);

            List<Models.Cohort> cohorts;
            if (!isMentorOnly)
            {
                cohorts = !string.IsNullOrEmpty(_villageFilter) && int.TryParse(_villageFilter, out var vid)
                    ? await CohortService.GetCohortsByVillageAsync(vid)
                    : await CohortService.GetCohortsAsync();
            }
            else
            {
                cohorts = await CohortService.GetCohortsByMentorAsync(PageState.User.Username);
                // Pre-restrict grower IDs to those in the mentor's cohorts
                if (cohorts.Count > 0)
                {
                    var memberTasks = cohorts.Select(c => CohortService.GetGrowerCohortsAsync(c.CohortId));
                    var memberResults = await Task.WhenAll(memberTasks);
                    _cohortGrowerIds = memberResults.SelectMany(m => m).Select(m => m.GrowerId).ToHashSet();
                }
            }

            _cohorts = cohorts ?? new List<Models.Cohort>();
            await logger.LogInformation("Loaded {Count} cohorts for grower screen (mentorOnly={IsMentorOnly})",
                _cohorts.Count, isMentorOnly);
        }
        catch (Exception ex)
        {
            _cohorts = new List<Models.Cohort>();
            await logger.LogError(ex, "Error Loading Cohorts for grower screen {Error}", ex.Message);
        }
    }

    private async Task LoadSummaryAsync()
    {
        int? villageId = string.IsNullOrEmpty(_villageFilter) ? null : int.Parse(_villageFilter);
        _summary = await GrowerService.GetStatusSummaryAsync(villageId);
    }

    private async Task LoadGrowersAsync()
    {
        int? villageId = string.IsNullOrEmpty(_villageFilter) ? null : int.Parse(_villageFilter);

        if (string.IsNullOrEmpty(_statusFilter))
        {
            _growers = await GrowerService.GetAllGrowersAsync(villageId) ?? new List<Models.Grower>();
        }
        else
        {
            var status = (GrowerStatus)Enum.Parse(typeof(GrowerStatus), _statusFilter);
            _growers = await GrowerService.GetGrowersByStatusAsync(status, villageId) ?? new List<Models.Grower>();
        }

        // Apply cohort filter: if a specific cohort is selected by admin, load that cohort's grower IDs
        if (!string.IsNullOrEmpty(_cohortFilter) && int.TryParse(_cohortFilter, out var cohortId))
        {
            var members = await CohortService.GetGrowerCohortsAsync(cohortId);
            var ids = members.Select(m => m.GrowerId).ToHashSet();
            _growers = _growers.Where(g => ids.Contains(g.GrowerId)).ToList();
        }
        else if (_cohortGrowerIds != null)
        {
            // Mentor role: restrict to growers in their assigned cohorts
            _growers = _growers.Where(g => _cohortGrowerIds.Contains(g.GrowerId)).ToList();
        }

        // Apply name filter
        if (!string.IsNullOrWhiteSpace(_nameFilter))
        {
            var f = _nameFilter.Trim().ToLowerInvariant();
            _growers = _growers.Where(g => g.GrowerName?.ToLowerInvariant().Contains(f) ?? false).ToList();
        }

        await LoadSummaryAsync();
        StateHasChanged();
    }

    private static (string Last, string First) SplitName(string fullName)
    {
        var trimmed = fullName?.Trim() ?? string.Empty;
        var idx = trimmed.LastIndexOf(' ');
        return idx < 0 ? (trimmed, string.Empty) : (trimmed[(idx + 1)..], trimmed[..idx]);
    }

    private IEnumerable<Models.Grower> SortedGrowers()
    {
        IOrderedEnumerable<Models.Grower> sorted = _sortBy switch
        {
            "firstname" => _growers.OrderBy(g => SplitName(g.GrowerName).First),
            "village"   => _growers.OrderBy(g => GetVillageName(g.VillageId)),
            "status"    => _growers.OrderBy(g => g.Status),
            "exitdate"  => _growers.OrderBy(g => g.ExitDate),
            _           => _growers.OrderBy(g => SplitName(g.GrowerName).Last)
                                    .ThenBy(g => SplitName(g.GrowerName).First),
        };
        return _sortAsc ? sorted : sorted.Reverse();
    }

    private void ApplyStatusFilter(string status)
    {
        _statusFilter = status;
        NavigateWithFilters();
    }

    private string BuildFilterQueryString()
    {
        var parts = new List<string>();
        if (!string.IsNullOrEmpty(_statusFilter))  parts.Add($"status={Uri.EscapeDataString(_statusFilter)}");
        if (!string.IsNullOrEmpty(_villageFilter)) parts.Add($"villageId={Uri.EscapeDataString(_villageFilter)}");
        if (!string.IsNullOrEmpty(_nameFilter))    parts.Add($"name={Uri.EscapeDataString(_nameFilter)}");
        if (_sortBy != "lastname")                 parts.Add($"sortBy={Uri.EscapeDataString(_sortBy)}");
        if (!_sortAsc)                             parts.Add("sortDesc=1");
        return string.Join("&", parts);
    }

    private void NavigateWithFilters()
    {
        var queryString = BuildFilterQueryString();
        NavigationManager.NavigateTo(NavigateUrl(PageState.Page.Path, queryString));
    }

    private string GetVillageName(int villageId)
    {
        return _villages?.FirstOrDefault(v => v.VillageId == villageId)?.VillageName ?? Localizer["UnknownVillage"];
    }

    private string GetStatusBadgeClass(GrowerStatus status)
    {
        return status switch
        {
            GrowerStatus.Active => "bg-success",
            GrowerStatus.Inactive => "bg-warning",
            GrowerStatus.Exited => "bg-secondary",
            _ => "bg-light"
        };
    }

    private string GetStatusText(GrowerStatus status)
    {
        return status switch
        {
            GrowerStatus.Active => Localizer["Status.Active"],
            GrowerStatus.Inactive => Localizer["Status.Inactive"],
            GrowerStatus.Exited => Localizer["Status.Exited"],
            _ => status.ToString()
        };
    }

    private async Task DeleteGrower(Models.Grower grower)
    {
        try
        {
            await GrowerService.DeleteGrowerAsync(grower.GrowerId, ModuleState.ModuleId);
            await logger.LogInformation("Grower Deleted {GrowerId}", grower.GrowerId);
            await LoadGrowersAsync();
        }
        catch (Exception ex)
        {
            await logger.LogError(ex, "Error Deleting Grower {GrowerId} {Error}", grower.GrowerId, ex.Message);
            AddModuleMessage(Localizer["Message.DeleteError"], MessageType.Error);
        }
    }
}
