@using OpenEug.TenTrees.Module.Training.Services
@using OpenEug.TenTrees.Module.Village.Services
@using OpenEug.TenTrees.Module.Cohort.Services
@using OpenEug.TenTrees.Models
@page "/training"

@namespace OpenEug.TenTrees.Module.Training
@inherits ModuleBase
@inject ITrainingService TrainingService
@inject IVillageService VillageService
@inject ICohortService CohortService
@inject NavigationManager NavigationManager
@inject IStringLocalizer<Index> Localizer

<div class="container">
    <!-- Action Buttons -->
    <div class="d-flex gap-2 mb-3">
        <ActionLink Action="Edit" Security="SecurityAccessLevel.Edit" Text="@Localizer["Action.AddSession"]" ResourceKey="AddSession" Class="btn btn-primary" />
    </div>

    <!-- Filter Section -->
    <div class="row mb-3">
        <div class="col-md-4">
            <label for="villageFilter">@Localizer["Filter.Village"]</label>
            <select id="villageFilter" class="form-select" @bind="_villageFilter">
                <option value="">@Localizer["Filter.AllVillages"]</option>
                @if (_villages != null)
                {
                    @foreach (var village in _villages)
                    {
                        <option value="@village.VillageId">@village.VillageName</option>
                    }
                }
            </select>
        </div>
        <div class="col-md-4 d-flex align-items-end gap-2">
            <button class="btn btn-primary w-100" @onclick="ApplyFiltersAndRefresh">Filter</button>
            <button class="btn btn-secondary w-100" @onclick="ClearFilters">@Localizer["Action.ClearFilters"]</button>
        </div>
    </div>

    <!-- Status Summary -->
    @if (_summary != null)
    {
        <div class="row mb-3">
            <div class="col-md-3">
                <button type="button" class="card text-center bg-success-subtle w-100" @onclick='() => ApplySummaryStatusFilter("Eligible")'>
                    <div class="card-body">
                        <h5 class="card-title">@_summary.Eligible</h5>
                        <p class="card-text">@Localizer["Status.Eligible"]</p>
                    </div>
                </button>
            </div>
            <div class="col-md-3">
                <button type="button" class="card text-center bg-warning-subtle w-100" @onclick='() => ApplySummaryStatusFilter("InProgress")'>
                    <div class="card-body">
                        <h5 class="card-title">@_summary.InProgress</h5>
                        <p class="card-text">@Localizer["Status.InProgress"]</p>
                    </div>
                </button>
            </div>
            <div class="col-md-3">
                <button type="button" class="card text-center bg-secondary-subtle w-100" @onclick='() => ApplySummaryStatusFilter("NotStarted")'>
                    <div class="card-body">
                        <h5 class="card-title">@_summary.NotStarted</h5>
                        <p class="card-text">@Localizer["Status.NotStarted"]</p>
                    </div>
                </button>
            </div>
            <div class="col-md-3">
                <button type="button" class="card text-center bg-primary-subtle w-100" @onclick="() => ApplySummaryStatusFilter(string.Empty)">
                    <div class="card-body">
                        <h5 class="card-title">@_summary.Total</h5>
                        <p class="card-text">@Localizer["Summary.Total"]</p>
                    </div>
                </button>
            </div>
        </div>
    }

    <!-- Training Sessions List -->
    @if (_classes == null)
    {
        <p><em>@Localizer["Message.Loading"]</em></p>
    }
    else
    {
        <div class="card mb-3">
            <div class="card-header">
                <h5>@Localizer["Section.TrainingSessions"]</h5>
            </div>
            <div class="card-body">
                @if (_classes.Count == 0)
                {
                    <p>@Localizer["Message.NoSessions"]</p>
                }
                else
                {
                    <Pager Items="@_classes"
                           Format="Table"
                           Class="table table-striped"
                           PageSize="@Int32.MaxValue.ToString()">
                        <Header>
                            <th style="width: 1px;"><span class="visually-hidden">@Localizer["Action.Edit"]</span></th>
                            <th style="width: 1px;"><span class="visually-hidden">@Localizer["Action.Delete"]</span></th>
                            <th>@Localizer["Column.ClassName"]</th>
                            <th>@Localizer["Column.ClassNumber"]</th>
                            <th>@Localizer["Column.Date"]</th>
                            <th>@Localizer["Column.Village"]</th>
                            <th>Cohorts</th>
                            <th>@Localizer["Column.Actions"]</th>
                        </Header>
                        <Row>
                            <td><ActionLink Action="Edit" Parameters="@($"id={context.TrainingClassId}&returnurl={Uri.EscapeDataString(GetReturnUrl())}")" ResourceKey="Edit" /></td>
                            <td><ActionDialog Header="Delete Session" Message="@Localizer["Message.ConfirmDelete"]" Action="Delete" Security="SecurityAccessLevel.Edit" Class="btn btn-danger" OnClick="@(async () => await DeleteClass(context))" ResourceKey="Delete" Id="@context.TrainingClassId.ToString()" /></td>
                            <td>@context.ClassName</td>
                            <td>
                                <span class="badge bg-info">@context.ClassNumber @Localizer["Label.OfTotal"]</span>
                            </td>
                            <td>@context.ClassDate.ToString("yyyy-MM-dd")</td>
                            <td>@GetVillageName(context.VillageId)</td>
                            <td>
                                @if (_classCohorts.TryGetValue(context.TrainingClassId, out var cohorts))
                                {
                                    @foreach (var name in cohorts)
                                    {
                                        <span class="badge bg-primary me-1">@name</span>
                                    }
                                }
                            </td>
                            <td>
                                <ActionLink Action="Attendance"
                                           Parameters="@($"id={context.TrainingClassId}&returnurl={Uri.EscapeDataString(GetReturnUrl())}")"
                                           Text="@Localizer["Action.MarkAttendance"]"
                                           ResourceKey="MarkAttendance"
                                           Class="btn btn-sm btn-primary" />
                            </td>
                        </Row>
                    </Pager>
                }
            </div>
        </div>
    }

    <!-- Grower Attendance Summary -->
    @if (_attendanceSummaries != null)
    {
        <div class="card mb-3">
            <div class="card-header">
                <h5>@Localizer["Section.GrowerAttendance"]</h5>
            </div>
            <div class="card-body">
                @if (_attendanceSummaries.Count == 0)
                {
                    <p>@Localizer["Message.NoGrowers"]</p>
                }
                else
                {
                    <Pager Items="@_attendanceSummaries"
                           Format="Table"
                           Class="table table-striped"
                           PageSize="@_pageSize.ToString()">
                        <Header>
                            <th>@Localizer["Column.GrowerName"]</th>
                            <th>@Localizer["Column.Village"]</th>
                            <th>@Localizer["Column.Attended"]</th>
                            <th>@Localizer["Column.Status"]</th>
                        </Header>
                        <Row>
                            @{
                                var rowClass = context.IsEligible ? "" :
                                               context.ClassesAttended > 0 ? "table-warning" : "";
                            }
                            <td class="@rowClass">@context.GrowerName</td>
                            <td class="@rowClass">@(context.VillageName ?? Localizer["UnknownVillage"])</td>
                            <td class="@rowClass">@context.ClassesAttended @Localizer["Label.Of"] @context.TotalRequired</td>
                            <td class="@rowClass">
                                <span class="badge @GetEligibilityBadgeClass(context)">
                                    @GetEligibilityText(context)
                                </span>
                            </td>
                        </Row>
                    </Pager>
                }
            </div>
        </div>
    }
</div>

@code {
    private List<TrainingClass> _classes;
    private List<AttendanceSummaryViewModel> _attendanceSummaries;
    private List<AttendanceSummaryViewModel> _allAttendanceSummaries;
    private List<Models.Village> _villages;
    private TrainingStatusSummary _summary;
    private string _villageFilter = "";
    private string _summaryStatusFilter = "";
    // classId → ordered list of cohort names
    private Dictionary<int, List<string>> _classCohorts = new();
    private bool _isLoading = false;
    private const int _pageSize = 20;

    protected override async Task OnParametersSetAsync()
    {
        // In-flight re-entry guard: prevents a concurrent second invocation
        // (from cascading parameter updates) from racing with the first load and
        // dropping a newly-created session (issue #125). Unlike a permanent flag,
        // this resets after each load so future parameter-driven refreshes still work.
        if (_isLoading) return;
        _isLoading = true;

        try
        {
            await LoadVillagesAsync();
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            await logger.LogError(ex, "Error Loading Training {Error}", ex.Message);
            AddModuleMessage(Localizer["Message.LoadError"], MessageType.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task LoadVillagesAsync()
    {
        _villages = UserSecurity.IsAuthorized(PageState.User, AppRoleNames.TenTreesAdmin)
            ? await VillageService.GetVillagesAsync()
            : await VillageService.GetActiveVillagesAsync();
    }

    private async Task LoadDataAsync()
    {
        int? villageId = string.IsNullOrEmpty(_villageFilter) ? null : int.Parse(_villageFilter);
        _classes = await TrainingService.GetTrainingClassesAsync(ModuleState.ModuleId, villageId);
        _allAttendanceSummaries = await TrainingService.GetAttendanceSummariesAsync(ModuleState.ModuleId, villageId);
        _summary = await TrainingService.GetTrainingStatusSummaryAsync(ModuleState.ModuleId, villageId);

        ApplySummaryFilter();

        _classCohorts = new();
        if (UserSecurity.IsAuthorized(PageState.User, AppRoleNames.TenTreesAdmin))
        {
            var allCohorts = await CohortService.GetCohortsAsync();
            var cohortById = allCohorts.ToDictionary(c => c.CohortId, c => c.Name);
            foreach (var tc in _classes)
            {
                var links = await CohortService.GetCohortsForClassAsync(tc.TrainingClassId);
                _classCohorts[tc.TrainingClassId] = links
                    .Select(l => l.CohortId.HasValue
                        ? cohortById.GetValueOrDefault(l.CohortId.Value, $"#{l.CohortId.Value}")
                        : "#(unassigned)")
                    .OrderBy(n => n).ToList();
            }
        }

        StateHasChanged();
    }

    private void ApplySummaryFilter()
    {
        _attendanceSummaries = _summaryStatusFilter switch
        {
            "Eligible" => _allAttendanceSummaries.Where(s => s.IsEligible).ToList(),
            "InProgress" => _allAttendanceSummaries.Where(s => !s.IsEligible && s.ClassesAttended > 0).ToList(),
            "NotStarted" => _allAttendanceSummaries.Where(s => s.ClassesAttended == 0).ToList(),
            _ => _allAttendanceSummaries
        };
    }

    private async Task ApplyFiltersAndRefresh()
    {
        await LoadDataAsync();
    }

    private async Task ApplySummaryStatusFilter(string status)
    {
        _summaryStatusFilter = status;
        ApplySummaryFilter();
        StateHasChanged();
        await Task.CompletedTask;
    }

    private async Task ClearFilters()
    {
        _villageFilter = "";
        _summaryStatusFilter = "";
        await LoadDataAsync();
    }

    private async Task DeleteClass(TrainingClass trainingClass)
    {
        try
        {
            await TrainingService.DeleteTrainingClassAsync(trainingClass.TrainingClassId, ModuleState.ModuleId);
            await logger.LogInformation("Training Class Deleted {TrainingClass}", trainingClass.ClassName);
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            await logger.LogError(ex, "Error Deleting Training Class {ClassName} {Error}", trainingClass.ClassName, ex.Message);
            AddModuleMessage(Localizer["Message.DeleteError"], MessageType.Error);
        }
    }

    private string GetReturnUrl()
    {
        var queryString = $"villageId={Uri.EscapeDataString(_villageFilter)}&summaryStatus={Uri.EscapeDataString(_summaryStatusFilter)}";
        return NavigateUrl(PageState.Page.Path, queryString);
    }

    private string GetVillageName(int villageId)
    {
        return _villages?.FirstOrDefault(v => v.VillageId == villageId)?.VillageName ?? Localizer["UnknownVillage"];
    }

    private string GetEligibilityBadgeClass(AttendanceSummaryViewModel summary)
    {
        if (summary.IsEligible) return "bg-success";
        if (summary.ClassesAttended > 0) return "bg-warning";
        return "bg-secondary";
    }

    private string GetEligibilityText(AttendanceSummaryViewModel summary)
    {
        if (summary.IsEligible) return Localizer["Status.EligibleForTrees"];
        if (summary.ClassesAttended > 0)
            return string.Format(Localizer["Status.ClassesRemaining"], summary.TotalRequired - summary.ClassesAttended);
        return Localizer["Status.NotStarted"];
    }
}
