@page "/Home"

@namespace OpenEug.TenTrees.Module.Home
@inherits ModuleBase
@inject IStringLocalizer<Index> Localizer

<div class="d-flex flex-nowrap">
    <h2>@Localizer["Heading.Welcome"]</h2>
</div>
<hr class="app-rule" />

@if (_workflowTiles.Any() || _adminTiles.Any() || _otherTiles.Any())
{
    @if (_workflowTiles.Any())
    {
        <div class="d-flex flex-nowrap">
            <h5>@Localizer["Section.Workflow"]</h5>
		</div>
        <hr class="app-rule" />
        @RenderTiles(_workflowTiles)
    }
    @if (_adminTiles.Any())
    {
        <div class="d-flex flex-nowrap">
            <h5 class="@(_workflowTiles.Any() ? "mt-4" : "")">@Localizer["Section.Admin"]</h5>
        </div>
        <hr class="app-rule" />
        @RenderTiles(_adminTiles)
    }
  
}
else
{
    <p role="status"><em>@Localizer["Message.Loading"]</em></p>
}

@code {
    private List<Tile> _workflowTiles = new();
    private List<Tile> _adminTiles = new();
    private List<Tile> _otherTiles = new();

    private class Tile
    {
        public string Name { get; set; }
        public string Description { get; set; }
        public string Path { get; set; }
        public string Icon { get; set; }
    }

    // tile names keyed by Oqtane page name so display labels can be localized without changing page metadata
    private static readonly Dictionary<string, string> _tileNameKeys = new(StringComparer.OrdinalIgnoreCase)
    {
        ["Enrollment"] = "TileName.Enrollment",
        ["Classes"] = "TileName.Classes",
        ["Training"] = "TileName.Training",
        ["Grower"] = "TileName.Grower",
        ["Assessment"] = "TileName.Assessment",
        ["Village"] = "TileName.Village",
        ["Cohort"] = "TileName.Cohort",
        ["Mentor"] = "TileName.Mentor",
        ["TreeType"] = "TileName.TreeType",
    };

    // brief descriptions keyed by page name and looked up via resx so they can be localized - Page has no description field of its own
    private static readonly Dictionary<string, string> _descriptionKeys = new(StringComparer.OrdinalIgnoreCase)
    {
        ["Grower"] = "Description.Grower",
        ["Assessment"] = "Description.Assessment",
        ["Cohort"] = "Description.Cohort",
        ["Training"] = "Description.Training",
        ["Classes"] = "Description.Classes",
        ["Village"] = "Description.Village",
        ["TreeType"] = "Description.TreeType",
        ["Mentor"] = "Description.Mentor",
        ["Enrollment"] = "Description.Enrollment",
    };

    // the order boxes should appear in - follows the flow of the work rather than PageState's own Page.Order
    private static readonly string[] _workflowOrder = { "Enrollment", "Classes", "Training", "Grower", "Assessment" };
    private static readonly string[] _adminOrder = { "Village", "Cohort", "Mentor", "TreeType" };

    protected override void OnParametersSet()
    {
        var eligiblePages = PageState.Pages
            .Where(p => p.IsNavigation && p.PageId != PageState.Page.PageId)
            .Select(p => new Tile
            {
                Name = p.Name,
                Path = p.Path,
                Icon = p.Icon,
                Description = _descriptionKeys.TryGetValue(p.Name, out var descriptionKey) ? Localizer[descriptionKey] : string.Empty
            });

        var topLevelPages = eligiblePages.Where(p =>
            PageState.Pages.FirstOrDefault(page => page.Path == p.Path)?.ParentId == null);

        _workflowTiles = OrderBySection(topLevelPages, _workflowOrder);

        var adminPages = eligiblePages.Where(p => p.Path.StartsWith("/adm/", StringComparison.OrdinalIgnoreCase));
        _adminTiles = OrderBySection(adminPages, _adminOrder);

        var placed = _workflowTiles.Concat(_adminTiles).Select(t => t.Path).ToHashSet();
        _otherTiles = eligiblePages.Where(t => !placed.Contains(t.Path)).OrderBy(t => t.Name).ToList();
    }

    private static List<Tile> OrderBySection(IEnumerable<Tile> tiles, string[] order)
    {
        return order
            .Select(name => tiles.FirstOrDefault(t => string.Equals(t.Name, name, StringComparison.OrdinalIgnoreCase)))
            .Where(t => t != null)
            .DistinctBy(t => t.Path)
            .ToList();
    }

    private string GetTileName(string pageName)
    {
        if (!_tileNameKeys.TryGetValue(pageName, out var resourceKey))
        {
            return pageName;
        }

        var localizedName = Localizer[resourceKey];
        return localizedName.ResourceNotFound ? pageName : localizedName.Value;
    }

    private RenderFragment RenderTiles(List<Tile> tiles) => @<div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-3 py-2">
        @foreach (var tile in tiles)
        {
            <div class="col">
                <a href="@NavigateUrl(tile.Path)" class="card h-100 text-decoration-none text-reset home-tile">
                    <div class="card-body">
                        <h5 class="card-title">
                            @if (!string.IsNullOrEmpty(tile.Icon))
                            {
                                <span class="@tile.Icon me-2" aria-hidden="true"></span>
                            }
                            @GetTileName(tile.Name)
                        </h5>
                        @if (!string.IsNullOrEmpty(tile.Description))
                        {
                            <p class="card-text text-muted mb-0">@tile.Description</p>
                        }
                    </div>
                </a>
            </div>
        }
    </div>;
}
